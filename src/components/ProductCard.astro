---
import {money,whatsapp} from '../data/products.js';
const {product:p}=Astro.props;
---
<article class="product-card">
<a href={`/product/${p.slug}/`} class="product-visual" aria-label={p.name}>
{p.image?<img src={p.image} alt={p.name} loading="lazy" width="420" height="420"/>:<div class="product-placeholder"><span>{p.category==='subscription'?'NASA':'PLAYER'}</span><strong>{p.months?p.months+' MONTHS':'LIFETIME'}</strong><small>PREMIUM DIGITAL</small></div>}
</a>
<div class="product-content"><span class="eyebrow" data-en={p.category==='activation'?'Player activation':'Subscription'} data-ar={p.category==='activation'?'تفعيل مشغل':'اشتراك'}>{p.category==='activation'?'Player activation':'Subscription'}</span>
<h3><a href={`/product/${p.slug}/`} data-en={p.name} data-ar={p.ar}>{p.name}</a></h3><div class="product-price">{money(p.price)} {p.old&&<del>{money(p.old)}</del>}</div>
<div class="product-buttons"><a class="btn btn-outline" href={`/product/${p.slug}/`} data-en="Details" data-ar="التفاصيل">Details</a><a class="btn" href={whatsapp(p)} target="_blank" rel="noopener" data-en="Order via WhatsApp" data-ar="اطلب عبر واتساب">Order via WhatsApp</a></div></div></article>
