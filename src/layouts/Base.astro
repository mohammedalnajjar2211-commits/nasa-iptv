---
import '../styles/site.css';
const {title='NASA IPTV | Streaming & Player Activations',description='Explore subscription plans, player activations, apps and support at NASA IPTV.',canonical=Astro.url.pathname}=Astro.props;
const path = Astro.url.pathname;
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#081c3b"/>
<meta name="description" content={description}/><title>{title}</title>
<link rel="canonical" href={new URL(canonical,Astro.site).href}/>
<link rel="icon" type="image/png" sizes="256x256" href="/nasa-iptv/favicon.png"/><link rel="apple-touch-icon" href="/nasa-iptv/apple-touch-icon.png"/>
<meta name="robots" content="index,follow,max-image-preview:large"/><meta property="og:site_name" content="NASA IPTV"/><meta name="twitter:card" content="summary_large_image"/><meta property="og:image" content={new URL("/nasa-iptv/images/nasa-logo-original.png",Astro.site).href}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
<script is:inline>try{document.documentElement.dataset.lang=localStorage.getItem('nasa-lang')||'en'}catch(e){document.documentElement.dataset.lang='en'}</script>
</head><body>
<header class="header">
<div class="nasa-weather-bar" id="nasa-weather-bar" hidden aria-label="Local weather">
  <div class="container nasa-weather-inner">
    <span class="nasa-weather-icon" id="nasa-weather-icon" aria-hidden="true">☀️</span>
    <span class="nasa-weather-temp" id="nasa-weather-temp"></span>
    <span class="nasa-weather-city" id="nasa-weather-city" dir="auto"></span>
    <span class="nasa-weather-caption" data-en="Local weather" data-ar="طقس مدينتك">Local weather</span>
  </div>
</div>
<div class="container nav-wrap"><a href="/nasa-iptv/" class="brand" aria-label="NASA IPTV Home"><img class="brand-logo" src="/nasa-iptv/images/nasa-logo-original.png" width="114" height="61" alt="NASA IPTV" decoding="async"/><span class="brand-caption">STREAM SMARTER</span></a>
<button class="menu-toggle" id="menu-toggle" aria-label="Open navigation" aria-controls="nav" aria-expanded="false"><span></span><span></span><span></span></button>
<nav class="nav" id="nav"><a href="/nasa-iptv/" data-en="Home" data-ar="الرئيسية">Home</a><a href="/nasa-iptv/shop/" data-en="Shop" data-ar="المتجر">Shop</a><a href="/nasa-iptv/subscriptions/" data-en="Subscriptions" data-ar="الاشتراكات">Subscriptions</a><a href="/nasa-iptv/activations/" data-en="Player Activations" data-ar="تفعيل المشغلات">Player Activations</a><a href="/nasa-iptv/apps/" data-en="Apps" data-ar="التطبيقات">Apps</a><a href="/nasa-iptv/help-center/" data-en="Support" data-ar="المساعدة">Support</a><a href="/nasa-iptv/reseller/" data-en="Reseller" data-ar="الوكلاء">Reseller</a><a href="/nasa-iptv/check-iptv/" data-en="Check IPTV" data-ar="افحص اشتراكك">Check IPTV</a></nav>
<div class="nav-actions"><div class="nasa-language-picker" id="nasa-language-picker">
<button type="button" class="lang-btn nasa-language-trigger" id="lang-toggle" aria-label="Select language" aria-haspopup="true" aria-expanded="false" aria-controls="nasa-language-menu"><span class="lang-label">English</span></button>
<div class="nasa-language-menu" id="nasa-language-menu" hidden role="group" aria-label="Languages">
<button type="button" class="nasa-language-option" data-select-lang="en" lang="en"><span>English</span><span class="nasa-language-check" aria-hidden="true">✓</span></button>
<button type="button" class="nasa-language-option" data-select-lang="ar" lang="ar"><span>العربية</span><span class="nasa-language-check" aria-hidden="true">✓</span></button>
</div></div><a class="btn btn-small" href="https://wa.me/46700411342" target="_blank" rel="noopener"><span data-en="WhatsApp" data-ar="واتساب">WhatsApp</span> ↗</a></div></div></header>
<main><slot/></main>
<footer class="footer"><div class="container footer-grid"><div class="footer-about"><a class="brand footer-brand" href="/nasa-iptv/"><img class="brand-logo" src="/nasa-iptv/images/nasa-logo-original.png" width="114" height="61" alt="NASA IPTV" loading="lazy"/></a><p data-en="Simple plans, convenient player activations and friendly assistance." data-ar="باقات واضحة وتفعيل للمشغلات ومساعدة في اختيار الأنسب.">Simple plans, convenient player activations and friendly assistance.</p></div><div><h3 data-en="Explore" data-ar="استكشف">Explore</h3><a href="/nasa-iptv/shop/">Shop | المتجر</a><a href="/nasa-iptv/apps/">Apps | التطبيقات</a><a href="/nasa-iptv/help-center/">Help | المساعدة</a><a href="/nasa-iptv/reseller/">Reseller | الوكلاء</a><a href="/nasa-iptv/check-iptv/">Check IPTV | فحص الاشتراك</a></div><div><h3 data-en="Information" data-ar="معلومات">Information</h3><a href="/nasa-iptv/policy/">Policies | السياسات</a><a href="/nasa-iptv/disclaimer/" data-en="Disclaimer" data-ar="إخلاء المسؤولية">Disclaimer</a><a href="/nasa-iptv/contact/">Contact | التواصل</a><a href="/nasa-iptv/sitemap.xml">Sitemap</a></div><div><h3 data-en="Contact" data-ar="تواصل معنا">Contact</h3><a href="https://wa.me/46700411342">+46700411342</a><p data-en="Orders are arranged through WhatsApp; no payment is processed on this website." data-ar="تتم الطلبات عبر واتساب ولا تُعالج المدفوعات داخل هذا الموقع.">Orders are arranged through WhatsApp; no payment is processed on this website.</p></div></div><div class="container copyright">© {new Date().getFullYear()} NASA IPTV. All rights reserved.</div></footer>
<nav class="mobile-dock" aria-label="Mobile quick navigation">
<a href="/nasa-iptv/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 9-8 9 8v10h-6v-7H9v7H3z"/></svg><span data-en="Home" data-ar="الرئيسية">Home</span></a>
<a href="/nasa-iptv/subscriptions/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 14h6"/></svg><span data-en="Plans" data-ar="الاشتراكات">Plans</span></a>
<a href="/nasa-iptv/apps/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span data-en="Apps" data-ar="التطبيقات">Apps</span></a>
<a href="/nasa-iptv/check-iptv/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5m-13-10 2 2 4-4"/></svg><span data-en="Check IPTV" data-ar="افحص اشتراكك">Check IPTV</span></a>
</nav>
<a class="floating-wa" href="https://wa.me/46700411342" target="_blank" rel="noopener" aria-label="Contact us on WhatsApp">✆</a>
<style>
/* Compact weather strip; outside nav-wrap so mobile logo/menu layout stays intact. */
.nasa-weather-bar[hidden]{display:none!important}
.nasa-weather-bar{background:linear-gradient(90deg,#07172d,#0b315b);border-bottom:1px solid rgba(120,185,245,.22);color:#e9f5ff}
.nasa-weather-inner{min-height:30px;display:flex;align-items:center;justify-content:flex-end;gap:7px;font-size:12px;line-height:1.2;direction:ltr}
.nasa-weather-icon{font-size:16px;line-height:1}.nasa-weather-temp{font-weight:800;font-variant-numeric:tabular-nums}.nasa-weather-city{font-weight:600;max-width:145px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nasa-weather-caption{color:#a5c8ed;border-inline-start:1px solid #426184;padding-inline-start:8px;margin-inline-start:2px}
@media(max-width:600px){.nasa-weather-inner{min-height:27px;font-size:11px;gap:5px}.nasa-weather-icon{font-size:14px}.nasa-weather-city{max-width:115px}.nasa-weather-caption{display:none}}
/* Language picker: English primary, Arabic secondary */
.nasa-language-picker{position:relative;display:inline-flex;direction:ltr;z-index:90}
.nasa-language-trigger{display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;cursor:pointer}
.nasa-language-menu[hidden]{display:none!important}
.nasa-language-menu{position:absolute;top:calc(100% + 9px);right:0;left:auto;min-width:155px;padding:7px;background:#10163d;border:1px solid rgba(127,155,235,.28);border-radius:10px;box-shadow:0 14px 35px rgba(0,0,0,.38);display:grid;gap:3px;direction:ltr}
.nasa-language-option{appearance:none;border:0;background:transparent;color:#f6f8ff;width:100%;display:flex;align-items:center;gap:10px;padding:10px 11px;border-radius:6px;font:inherit;font-size:13px;text-align:left;cursor:pointer;white-space:nowrap}
.nasa-language-option:hover,.nasa-language-option:focus-visible{background:#243368;outline:none}
.nasa-language-option.is-selected{background:#1b2b61}
.nasa-language-check{margin-left:auto;opacity:0;color:#a8d5ff}
.nasa-language-option.is-selected .nasa-language-check{opacity:1}
@media(max-width:600px){.nasa-language-trigger{gap:5px}.nasa-language-menu{min-width:145px}}
</style>
<script>
const languagePicker=document.querySelector('#nasa-language-picker');
const languageTrigger=document.querySelector('#lang-toggle');
const languageMenu=document.querySelector('#nasa-language-menu');
const closeLanguageMenu=()=>{if(languageMenu)languageMenu.hidden=true;if(languageTrigger)languageTrigger.setAttribute('aria-expanded','false')};
const setLang=(lang)=>{
  lang=lang==='ar'?'ar':'en';
  document.documentElement.dataset.lang=lang;
  document.documentElement.lang=lang;
  document.documentElement.dir=lang==='ar'?'rtl':'ltr';
  document.querySelectorAll('[data-en][data-ar]').forEach(el=>{el.textContent=el.dataset[lang]});
  if(languageTrigger){languageTrigger.querySelector('.lang-label').textContent=lang==='ar'?'العربية':'English'}
  document.querySelectorAll('[data-select-lang]').forEach(el=>{const selected=el.dataset.selectLang===lang;el.classList.toggle('is-selected',selected);el.setAttribute('aria-pressed',String(selected))});
  try{localStorage.setItem('nasa-lang',lang)}catch(e){}
  closeLanguageMenu();
};
setLang(document.documentElement.dataset.lang||'en');
languageTrigger?.addEventListener('click',()=>{const opening=languageMenu.hidden;languageMenu.hidden=!opening;languageTrigger.setAttribute('aria-expanded',String(opening))});
document.querySelectorAll('[data-select-lang]').forEach(btn=>btn.addEventListener('click',()=>setLang(btn.dataset.selectLang)));
document.addEventListener('click',e=>{if(languagePicker&&!languagePicker.contains(e.target))closeLanguageMenu()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeLanguageMenu()});
document.querySelector('#menu-toggle')?.addEventListener('click',()=>{let nav=document.querySelector('#nav');nav.classList.toggle('open');document.querySelector('#menu-toggle').setAttribute('aria-expanded',nav.classList.contains('open')?'true':'false')});
document.querySelectorAll('.mobile-dock a').forEach(a=>{if(a.pathname===location.pathname)a.classList.add('active')});
const observer=new IntersectionObserver((entries)=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('in-view');observer.unobserve(entry.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>{document.querySelector('#nav')?.classList.remove('open');document.querySelector('#menu-toggle')?.setAttribute('aria-expanded','false')}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector('#nav')?.classList.remove('open');document.querySelector('#menu-toggle')?.setAttribute('aria-expanded','false')}});

// Weather: approximate city from public IP; no GPS permission. Hide strip on network errors.
(async () => {
  const bar = document.querySelector('#nasa-weather-bar');
  if (!bar) return;
  const tempEl = document.querySelector('#nasa-weather-temp');
  const cityEl = document.querySelector('#nasa-weather-city');
  const iconEl = document.querySelector('#nasa-weather-icon');
  const show = (item) => {
    if (!item || !Number.isFinite(item.temp) || !item.city) return;
    tempEl.textContent = `${Math.round(item.temp)}°C`;
    cityEl.textContent = item.city;
    const code = item.code;
    iconEl.textContent = code === 0 ? '☀️' : [1,2].includes(code) ? '🌤️' : code === 3 ? '☁️' : [45,48].includes(code) ? '🌫️' : [51,53,55,56,57,61,63,65,66,67,80,81,82].includes(code) ? '🌧️' : [71,73,75,77,85,86].includes(code) ? '❄️' : [95,96,99].includes(code) ? '⛈️' : '🌡️';
    bar.hidden = false;
  };
  try {
    const cached = JSON.parse(sessionStorage.getItem('nasa-weather-v1') || 'null');
    if (cached && Date.now() - cached.at < 20 * 60 * 1000) { show(cached); return; }
  } catch (_) {}
  const fetchJson = async (url) => {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 7000);
    try {
      const res = await fetch(url, { signal: controller.signal, cache: 'no-store' });
      if (!res.ok) throw new Error('Weather request failed');
      return await res.json();
    } finally { clearTimeout(timer); }
  };
  try {
    const geo = await fetchJson('https://ipwho.is/');
    if (geo.success === false || !geo.city || !Number.isFinite(Number(geo.latitude)) || !Number.isFinite(Number(geo.longitude))) return;
    const lat = Number(geo.latitude), lon = Number(geo.longitude);
    const weather = await fetchJson(`https://api.open-meteo.com/v1/forecast?latitude=${encodeURIComponent(lat)}&longitude=${encodeURIComponent(lon)}&current=temperature_2m,weather_code&timezone=auto`);
    const item = { city: String(geo.city), temp: Number(weather.current?.temperature_2m), code: Number(weather.current?.weather_code), at: Date.now() };
    if (!Number.isFinite(item.temp)) return;
    show(item);
    try { sessionStorage.setItem('nasa-weather-v1', JSON.stringify(item)); } catch (_) {}
  } catch (_) { /* Weather is optional; never block the site. */ }
})();
</script>
</body></html>
