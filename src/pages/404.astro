
---
const home = "/";
const shop = "/shop/";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <title>404 - Page Not Found | NASA IPTV</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(
        circle at top,
        #251015 0%,
        #090b10 55%,
        #050609 100%
      );
      color: #fff;
      font-family: Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 24px;
    }

    .container {
      width: 100%;
      max-width: 620px;
    }

    .logo {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: 2px;
      margin-bottom: 30px;
    }

    .logo span { color: #ed243b; }

    h1 {
      font-size: clamp(110px, 24vw, 200px);
      line-height: 1;
      margin: 0;
      color: #ed243b;
      text-shadow: 0 0 60px #ed243b44;
    }

    h2 {
      font-size: 28px;
      margin: 18px 0;
    }

    p {
      color: #aeb4bf;
      line-height: 1.8;
      font-size: 16px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin-top: 30px;
    }

    .btn {
      display: inline-block;
      padding: 15px 24px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: bold;
      transition: .2s;
    }

    .primary {
      background: #ed243b;
      color: white;
    }

    .secondary {
      background: #191d26;
      border: 1px solid #343946;
      color: white;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .arabic {
      direction: rtl;
      margin-top: 20px;
    }
  </style>
</head>

<body>
  <main class="container">
    <div class="logo">NASA <span>IPTV</span></div>

    <h1>404</h1>
    <h2>Page Not Found</h2>

    <p>
      Sorry, the page you're looking for doesn't exist
      or has been moved.
    </p>

    <div class="arabic" lang="ar">
      <h2>الصفحة غير موجودة</h2>
      <p>
        عذراً، الصفحة التي تبحث عنها غير موجودة
        أو تم نقلها إلى عنوان آخر.
      </p>
    </div>

    <div class="buttons">
      <a class="btn primary" href={home}>
        Back to Home | الرئيسية
      </a>

      <a class="btn secondary" href={shop}>
        Browse Plans | الاشتراكات
      </a>
    </div>
  </main>
</body>
</html>
