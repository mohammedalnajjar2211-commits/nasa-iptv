---
import Base from '../layouts/Base.astro';
const guides = [
  {id:'android-tv',icon:'📺',en:'Android TV / Google TV',ar:'أندرويد TV / Google TV',enSteps:['Open Google Play Store on your TV.','Install a compatible IPTV player.','Open the player and select its supported login method.','Enter the subscription details provided by support and load your playlist.'],arSteps:['افتح متجر Google Play على التلفزيون.','ثبّت مشغل IPTV متوافقاً.','افتح المشغل واختر طريقة تسجيل الدخول المدعومة.','أدخل بيانات الاشتراك التي أرسلها الدعم ثم حمّل القائمة.']},
  {id:'samsung',icon:'📺',en:'Samsung Smart TV',ar:'تلفزيون سامسونج',enSteps:['Open Apps from your TV home screen.','Find an IPTV player available for your model and region.','Install it and check its activation or login method.','Add your subscription details and refresh the playlist.'],arSteps:['افتح Apps من شاشة التلفزيون الرئيسية.','ابحث عن مشغل IPTV متوفر لموديل جهازك ومنطقتك.','ثبّته وتحقق من طريقة التفعيل أو تسجيل الدخول.','أضف بيانات اشتراكك وحدّث القائمة.']},
  {id:'lg',icon:'📺',en:'LG webOS',ar:'تلفزيون LG',enSteps:['Open Apps or LG Content Store.','Choose a compatible IPTV player for your webOS version.','Install the app and open its login screen.','Add your subscription information and reload the playlist.'],arSteps:['افتح Apps أو LG Content Store.','اختر مشغلاً متوافقاً مع إصدار webOS لديك.','ثبّت التطبيق وافتح شاشة الدخول.','أضف بيانات الاشتراك وأعد تحميل القائمة.']},
  {id:'fire',icon:'🔥',en:'Amazon Fire TV',ar:'أمازون فاير TV',enSteps:['Open Find or Search on Fire TV.','Install a compatible player from the Amazon Appstore if available.','Open it and choose a supported login method.','Enter your subscription details and load the playlist.'],arSteps:['افتح البحث في جهاز Fire TV.','ثبّت مشغلاً متوافقاً من متجر Amazon إذا كان متاحاً.','افتحه واختر طريقة الدخول المدعومة.','أدخل بيانات اشتراكك وحمّل القائمة.']},
  {id:'iphone',icon:'📱',en:'iPhone / iPad',ar:'آيفون / آيباد',enSteps:['Open the App Store.','Find a compatible player using our apps page.','Install and launch the app.','Enter your subscription credentials or playlist URL, then save.'],arSteps:['افتح App Store.','اختر مشغلاً متوافقاً من صفحة تطبيقاتنا.','ثبّت التطبيق وافتحه.','أدخل بيانات الاشتراك أو رابط القائمة ثم احفظ.']},
  {id:'android',icon:'📱',en:'Android Phone / Tablet',ar:'هاتف / تابلت أندرويد',enSteps:['Open Google Play Store.','Install a compatible player from our apps page.','Open the player and select Xtream Codes or M3U if supported.','Enter your details and start watching.'],arSteps:['افتح Google Play.','ثبّت مشغلاً متوافقاً من صفحة تطبيقاتنا.','افتح المشغل واختر Xtream Codes أو M3U إذا كان مدعوماً.','أدخل بياناتك وابدأ المشاهدة.']},
  {id:'windows',icon:'💻',en:'Windows PC',ar:'كمبيوتر ويندوز',enSteps:['Open the NASA IPTV apps page.','Choose a compatible Windows player.','Download and install it from a trusted source.','Open it and enter your subscription details.'],arSteps:['افتح صفحة تطبيقات NASA IPTV.','اختر مشغل ويندوز متوافقاً.','حمّله وثبّته من مصدر موثوق.','افتحه وأدخل بيانات الاشتراك.']},
  {id:'mac',icon:'💻',en:'Mac',ar:'كمبيوتر ماك',enSteps:['Find a compatible macOS player from a trusted source.','Install and open it.','Choose its supported login method.','Enter the subscription details provided by support.'],arSteps:['ابحث عن مشغل macOS متوافق من مصدر موثوق.','ثبّته وافتحه.','اختر طريقة الدخول التي يدعمها.','أدخل بيانات الاشتراك التي أرسلها الدعم.']}
];
---
<Base title="Device Setup Guide | NASA IPTV" description="Setup guides for Smart TVs, Android, iPhone, Fire TV, Windows and Mac in English and Arabic.">
<section class="guide" id="device-guide"><div class="wrap">
<header class="hero"><div class="eyebrow" data-en="NASA IPTV • HELP CENTER" data-ar="ناسا IPTV • مركز المساعدة">NASA IPTV • HELP CENTER</div><h1 data-en="Device Setup Guide" data-ar="دليل إعداد الأجهزة">Device Setup Guide</h1><p data-en="Choose your device and follow simple step-by-step instructions." data-ar="اختر جهازك واتبع خطوات الإعداد بكل سهولة.">Choose your device and follow simple step-by-step instructions.</p><a class="btn primary" href="/apps/" data-en="Browse Apps" data-ar="تصفح التطبيقات">Browse Apps</a></header>
<div class="layout"><aside class="sidebar"><h2 data-en="Choose your device" data-ar="اختر جهازك">Choose your device</h2><div class="devices">{guides.map(g=><button type="button" class="device" data-device={g.id} aria-pressed="false"><span aria-hidden="true">{g.icon}</span><span data-en={g.en} data-ar={g.ar}>{g.en}</span></button>)}</div></aside>
<article class="panel"><div class="eyebrow" data-en="STEP-BY-STEP" data-ar="خطوة بخطوة">STEP-BY-STEP</div><h2 id="selected-title">Android TV / Google TV</h2><p class="intro" data-en="Follow the steps below. App availability and login methods may differ by model and region." data-ar="اتبع الخطوات أدناه. قد تختلف التطبيقات وطرق الدخول حسب موديل الجهاز والمنطقة.">Follow the steps below. App availability and login methods may differ by model and region.</p><ol id="steps" class="steps"></ol><div class="notice"><strong data-en="Important" data-ar="مهم">Important</strong><p data-en="Some third-party players require separate activation. Never share your subscription password publicly." data-ar="بعض المشغلات الخارجية تتطلب تفعيلًا منفصلًا. لا تشارك كلمة مرور اشتراكك علناً.">Some third-party players require separate activation. Never share your subscription password publicly.</p></div><div class="actions"><a class="btn primary" href="/apps/" data-en="Compatible Apps" data-ar="التطبيقات المتوافقة">Compatible Apps</a><a class="btn whatsapp" href="https://wa.me/46700411342?text=Hello%20NASA%20IPTV%2C%20I%20need%20help%20setting%20up%20my%20device." target="_blank" rel="noopener noreferrer" data-en="WhatsApp Support" data-ar="الدعم عبر واتساب">WhatsApp Support</a></div></article></div>
<section class="faq"><h2 data-en="Frequently Asked Questions" data-ar="الأسئلة الشائعة">Frequently Asked Questions</h2><details><summary data-en="Where do I get my login details?" data-ar="من أين أحصل على بيانات الدخول؟">Where do I get my login details?</summary><p data-en="Support provides your subscription details after your order is confirmed." data-ar="يرسل لك الدعم بيانات الاشتراك بعد تأكيد الطلب.">Support provides your subscription details after your order is confirmed.</p></details><details><summary data-en="The app isn't in my store. What now?" data-ar="التطبيق غير موجود في المتجر، ماذا أفعل؟">The app isn't in my store. What now?</summary><p data-en="Availability varies by device and country. Check our apps page or contact support." data-ar="يختلف التوفر حسب الجهاز والدولة. راجع صفحة التطبيقات أو تواصل مع الدعم.">Availability varies by device and country. Check our apps page or contact support.</p></details><details><summary data-en="Is player activation included?" data-ar="هل تفعيل المشغل مشمول؟">Is player activation included?</summary><p data-en="Some third-party players charge a separate fee. Check the product details." data-ar="بعض المشغلات الخارجية تتطلب رسوماً منفصلة. راجع تفاصيل المنتج.">Some third-party players charge a separate fee. Check the product details.</p></details></section>
</div></section>
<script define:vars={{guides}}>
const root=document.getElementById('device-guide');
if(root){let selected='android-tv';const buttons=[...root.querySelectorAll('[data-device]')];const heading=root.querySelector('#selected-title');const list=root.querySelector('#steps');function render(){const g=guides.find(x=>x.id===selected)||guides[0];const ar=document.documentElement.dataset.lang==='ar';heading.textContent=ar?g.ar:g.en;list.replaceChildren();(ar?g.arSteps:g.enSteps).forEach((step,i)=>{const li=document.createElement('li');const num=document.createElement('b');num.textContent=String(i+1).padStart(2,'0');const txt=document.createElement('span');txt.textContent=step;li.append(num,txt);list.append(li)});buttons.forEach(b=>{const active=b.dataset.device===selected;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))})}buttons.forEach(b=>b.addEventListener('click',()=>{selected=b.dataset.device;render()}));new MutationObserver(render).observe(document.documentElement,{attributes:true,attributeFilter:['data-lang','lang']});render()}
</script>
</Base>
<style is:global>
#device-guide{min-height:80vh;padding:46px 16px 100px;color:#edf5ff;background:radial-gradient(ellipse at 15% 0%,#143b65,transparent 43%),linear-gradient(145deg,#07111f,#0b1d33 65%,#060c17)}#device-guide .wrap{max-width:1140px;margin:auto}#device-guide .hero{text-align:center;max-width:740px;margin:0 auto 38px}#device-guide .eyebrow{font-size:.75rem;letter-spacing:.14em;color:#79c8ff;font-weight:800}#device-guide .hero h1{font-size:clamp(2rem,5vw,3.4rem);line-height:1.15;color:#fff;margin:12px 0}#device-guide .hero p{color:#b7cbe1;line-height:1.8;margin:0 0 22px}#device-guide .btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:11px;padding:12px 19px;min-height:45px;font-weight:800;font-size:.9rem}#device-guide .primary{background:#1879e9;color:#fff!important}#device-guide .whatsapp{background:#147e60;color:#fff!important}#device-guide .layout{display:grid;grid-template-columns:330px minmax(0,1fr);gap:20px;align-items:start}#device-guide .sidebar,#device-guide .panel,#device-guide .faq{border:1px solid #29445e;background:#0c1c30;border-radius:20px;box-shadow:0 12px 35px #0002}#device-guide .sidebar{padding:20px}#device-guide .sidebar h2{font-size:1rem;color:#fff;margin:0 0 15px}#device-guide .devices{display:grid;gap:9px}#device-guide .device{width:100%;display:flex;align-items:center;gap:12px;text-align:start;font:inherit;font-size:.9rem;font-weight:700;color:#d2e2f4;background:#122840;border:1px solid #2b4561;border-radius:12px;padding:14px;cursor:pointer}#device-guide .device:hover{background:#193653}#device-guide .device.active{background:#143d63;border-color:#58b3ff;color:white}#device-guide .device span:first-child{font-size:1.3rem}#device-guide .panel{padding:clamp(20px,3vw,34px)}#device-guide .panel h2{color:white;margin:13px 0 8px;font-size:clamp(1.5rem,3vw,2rem)}#device-guide .intro{color:#b9cbe0;line-height:1.8;margin-bottom:22px}#device-guide .steps{padding:0;margin:0;list-style:none;display:grid;gap:12px}#device-guide .steps li{display:flex;gap:14px;align-items:flex-start;padding:16px;border-radius:13px;border:1px solid #294661;background:#142a43;line-height:1.7}#device-guide .steps b{color:#89d1ff;background:#1b4268;border-radius:8px;padding:4px 9px;font-size:.83rem}#device-guide .notice{background:#153149;border:1px solid #305777;border-radius:13px;padding:15px 17px;margin:22px 0}#device-guide .notice strong{color:#91d1ff}#device-guide .notice p{color:#c3d6e8;font-size:.9rem;line-height:1.7;margin:5px 0 0}#device-guide .actions{display:flex;gap:10px;flex-wrap:wrap}#device-guide .faq{margin-top:22px;padding:24px}#device-guide .faq h2{font-size:1.4rem;color:white;margin:0 0 12px}#device-guide .faq details{padding:15px 0;border-top:1px solid #29445e}#device-guide .faq summary{font-weight:700;cursor:pointer}#device-guide .faq p{color:#bdcee1;line-height:1.8;margin:10px 0 0}html[dir=rtl] #device-guide .device{text-align:right}@media(max-width:760px){#device-guide{padding:30px 12px 100px}#device-guide .layout{grid-template-columns:1fr}#device-guide .devices{grid-template-columns:repeat(2,minmax(0,1fr))}#device-guide .device{font-size:.82rem;padding:12px 9px}#device-guide .sidebar{padding:15px}#device-guide .panel{padding:20px}#device-guide .actions .btn{flex:1}}@media(max-width:360px){#device-guide .devices{grid-template-columns:1fr}}

/* Explicit fixes for global theme overrides and seasonal decorations */
#device-guide, #device-guide *{box-sizing:border-box}
#device-guide{width:100%;overflow-x:clip;isolation:isolate}
#device-guide .wrap{width:100%;max-width:1140px;margin-inline:auto;padding-inline:0}
#device-guide .hero{width:100%;max-width:740px;margin-inline:auto;background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;min-height:0!important}
#device-guide .hero h1{color:#fff!important;opacity:1!important;text-shadow:none!important}
#device-guide .hero p{color:#b7cbe1!important}
#device-guide .layout{width:100%;min-width:0}
#device-guide .sidebar,#device-guide .panel,#device-guide .faq{min-width:0}
#device-guide .faq details{display:block!important;background:#122840!important;border:1px solid #2b4561!important;border-radius:12px!important;margin:10px 0!important;padding:0!important;overflow:hidden}
#device-guide .faq summary{display:list-item!important;list-style:revert!important;list-style-position:inside!important;background:#122840!important;color:#f2f7ff!important;padding:16px 18px!important;border-radius:12px!important;cursor:pointer!important;font-size:.95rem!important;line-height:1.5!important}
#device-guide .faq details[open] summary{border-radius:12px 12px 0 0!important;border-bottom:1px solid #2b4561!important}
#device-guide .faq details p{color:#c8dbed!important;background:#122840!important;margin:0!important;padding:14px 18px 18px!important}
#device-guide .device{color:#e0efff!important}
#device-guide .device.active{background:#143d63!important;color:#fff!important}
body:has(#device-guide) #nasa-seasonal-root,body:has(#device-guide) #nasa-seasonal-banner{display:none!important}
@media(max-width:760px){#device-guide .layout{grid-template-columns:minmax(0,1fr)!important}#device-guide .wrap{padding-inline:0!important}#device-guide .devices{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@media(max-width:380px){#device-guide .devices{grid-template-columns:1fr!important}}

</style>
