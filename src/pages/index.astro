---
import Base from '../layouts/Base.astro';import ProductCard from '../components/ProductCard.astro';import {products,genericWhatsapp} from '../data/products.js';
const featured=products.filter(p=>p.featured||p.category==='activation'&&p.slug.includes('ora')).slice(0,3);
---
<Base title="NASA IPTV | Subscriptions, Apps & Player Activations" description="Modern NASA IPTV storefront. Browse subscriptions, ORA Player activations, downloads and support. Order via WhatsApp.">
<section class="hero"><div class="container hero-inner"><div><span class="eyebrow" data-en="YOUR ENTERTAINMENT. SIMPLIFIED." data-ar="ترفيهك أصبح أسهل">YOUR ENTERTAINMENT. SIMPLIFIED.</span><h1 data-en="A smarter way to enjoy your entertainment." data-ar="تجربة ترفيه أفضل، بتصميم أبسط وأسرع.">A smarter way to enjoy your entertainment.</h1><p data-en="Explore flexible subscription plans, easy player activations and useful apps. Choose your product and order directly through WhatsApp." data-ar="اكتشف باقات الاشتراك وتفعيل المشغلات والتطبيقات المناسبة لك. اختر المنتج وأرسل طلبك مباشرة عبر واتساب.">Explore flexible subscription plans, easy player activations and useful apps. Choose your product and order directly through WhatsApp.</p><div class="hero-actions"><a href="/nasa-iptv/shop/" class="btn" data-en="Explore products →" data-ar="تصفح المنتجات ←">Explore products →</a><a href="/nasa-iptv/apps/" class="btn btn-outline" data-en="Browse apps" data-ar="تصفح التطبيقات">Browse apps</a></div></div><div class="hero-visual" aria-hidden="true"><div class="tv-shell"><div class="tv-top">NASA <span>IPTV ●</span></div><div class="tv-banner"><small>STREAMING EXPERIENCE</small><strong>WATCH MORE.<br/>EXPLORE MORE.</strong></div><div class="tv-chips"><span>◉ LIVE TV</span><span>▣ MOVIES</span><span>▤ SERIES</span></div></div></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">OUR COLLECTION</span><h2 data-en="Featured products" data-ar="المنتجات المميزة">Featured products</h2><p class="muted" data-en="Popular options and player licenses." data-ar="باقات مميزة وتراخيص تفعيل المشغلات.">Popular options and player licenses.</p></div><a class="btn btn-outline" href="/nasa-iptv/shop/" data-en="View all products" data-ar="عرض جميع المنتجات">View all products</a></div><div class="grid">{featured.map(p=><ProductCard product={p}/>)}</div></div></section>
<section class="section features"><div class="container"><div class="section-head"><div><span class="eyebrow">WHY NASA</span><h2 data-en="Everything you need, in one place" data-ar="كل ما تحتاجه في مكان واحد">Everything you need, in one place</h2></div></div><div class="grid"><div class="feature"><div class="feature-icon">◈</div><h3 data-en="Flexible plans" data-ar="باقات مرنة">Flexible plans</h3><p data-en="Choose a subscription duration that suits your needs and budget." data-ar="اختر مدة الاشتراك التي تناسب احتياجاتك وميزانيتك.">Choose a subscription duration that suits your needs and budget.</p></div><div class="feature"><div class="feature-icon">▣</div><h3 data-en="Player activations" data-ar="تفعيل المشغلات">Player activations</h3><p data-en="Find activation options for supported media player applications." data-ar="خيارات تفعيل لتطبيقات تشغيل الوسائط المدعومة.">Find activation options for supported media player applications.</p></div><div class="feature"><div class="feature-icon">✦</div><h3 data-en="Human assistance" data-ar="مساعدة مباشرة">Human assistance</h3><p data-en="Ask questions and complete your order with our team on WhatsApp." data-ar="اسأل وأكمل طلبك بالتواصل المباشر عبر واتساب.">Ask questions and complete your order with our team on WhatsApp.</p></div></div></div></section>
<section class="section"><div class="container"><div class="cta"><div><h2 data-en="Need help choosing?" data-ar="تحتاج مساعدة في الاختيار؟">Need help choosing?</h2><p data-en="Tell us your device and what you're looking for." data-ar="أخبرنا بنوع جهازك وما تحتاجه وسنساعدك.">Tell us your device and what you're looking for.</p></div><a class="btn" href={genericWhatsapp('Hello NASA IPTV, I need help choosing a product.')} target="_blank" rel="noopener" data-en="Chat on WhatsApp ↗" data-ar="تواصل عبر واتساب ↗">Chat on WhatsApp ↗</a></div></div></section>
</Base>
