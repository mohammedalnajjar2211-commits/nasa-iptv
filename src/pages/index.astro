
---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, genericWhatsapp } from '../data/products.js';

const featured = products
  .filter(p => p.featured || (p.category === 'activation' && p.slug.includes('ora')))
  .slice(0, 3);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (path) => `${base}${path.replace(/^\/+/, '')}`;
---

<Base
  title="NASA IPTV | Subscriptions, Apps & Player Activations"
  description="Explore NASA IPTV subscriptions, ORA Player activations, apps and support. Order easily through WhatsApp."
>
  <section class="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source src={asset('videos/nasa-ambient.mp4')} type="video/mp4" />
    </video>

    <div class="hero-shade"></div>

    <div class="container hero-inner">
      <div class="hero-content">
        <span
          class="eyebrow"
          data-en="YOUR ENTERTAINMENT. SIMPLIFIED."
          data-ar="ترفيهك أصبح أسهل"
        >
          YOUR ENTERTAINMENT. SIMPLIFIED.
        </span>

        <h1
          data-en="Matches streaming you just can’t miss!"
          data-ar="تجربة ترفيه أفضل، بتصميم أبسط وأسرع."
        >
          Matches streaming you just can’t miss!
        </h1>

        <p
          data-en="Explore flexible subscription plans, easy player activations and useful apps. Choose your product and order directly through WhatsApp."
          data-ar="اكتشف باقات الاشتراك وتفعيل المشغلات والتطبيقات المناسبة لك. اختر المنتج وأرسل طلبك مباشرة عبر واتساب."
        >
          Explore flexible subscription plans, easy player activations and useful apps.
          Choose your product and order directly through WhatsApp.
        </p>

        <div class="hero-actions">
          <a
            href={asset('shop/')}
            class="btn"
            data-en="Explore products →"
            data-ar="تصفح المنتجات ←"
          >
            Explore products →
          </a>

          <a
            href={asset('apps/')}
            class="btn btn-outline"
            data-en="Browse apps"
            data-ar="تصفح التطبيقات"
          >
            Browse apps
          </a>
        </div>
      </div>

      <!-- NASA IPTV TV Preview -->
      <div class="hero-visual">
        <div class="tv-shell nasa-tv">
          <div class="nasa-tv-screen">
            <img
              src={asset('images/nasa-tv-screen.png')}
              alt="NASA IPTV television preview"
              width="1308"
              height="733"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <div class="nasa-tv-stand" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">OUR COLLECTION</span>
          <h2 data-en="Featured products" data-ar="المنتجات المميزة">
            Featured products
          </h2>
          <p
            class="muted"
            data-en="Popular options and player licenses."
            data-ar="باقات مميزة وتراخيص تفعيل المشغلات."
          >
            Popular options and player licenses.
          </p>
        </div>

        <a
          class="btn btn-outline"
          href={asset('shop/')}
          data-en="View all products"
          data-ar="عرض جميع المنتجات"
        >
          View all products
        </a>
      </div>

      <div class="grid">
        {featured.map(p => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- WHY NASA -->
  <section class="section features">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">WHY NASA</span>
          <h2
            data-en="Everything you need, in one place"
            data-ar="كل ما تحتاجه في مكان واحد"
          >
            Everything you need, in one place
          </h2>
        </div>
      </div>

      <div class="grid">
        <div class="feature reveal">
          <div class="feature-icon">✧</div>
          <h3 data-en="Flexible plans" data-ar="باقات مرنة">
            Flexible plans
          </h3>
          <p
            data-en="Choose a subscription duration that suits your needs and budget."
            data-ar="اختر مدة الاشتراك التي تناسب احتياجاتك وميزانيتك."
          >
            Choose a subscription duration that suits your needs and budget.
          </p>
        </div>

        <div class="feature reveal">
          <div class="feature-icon">▤</div>
          <h3 data-en="Player activations" data-ar="تفعيل المشغلات">
            Player activations
          </h3>
          <p
            data-en="Find activation options for supported media player applications."
            data-ar="خيارات تفعيل لتطبيقات تشغيل الوسائط المدعومة."
          >
            Find activation options for supported media player applications.
          </p>
        </div>

        <div class="feature reveal">
          <div class="feature-icon">✺</div>
          <h3 data-en="Human assistance" data-ar="مساعدة مباشرة">
            Human assistance
          </h3>
          <p
            data-en="Ask questions and complete your order with our team on WhatsApp."
            data-ar="اسأل وأكمل طلبك بالتواصل المباشر عبر واتساب."
          >
            Ask questions and complete your order with our team on WhatsApp.
          </p>
        </div>
      </div>

      <!-- Supported Devices -->
      <div class="device-section">
        <div class="section-head">
          <div>
            <span
              class="eyebrow"
              data-en="SUPPORTED PLATFORMS"
              data-ar="الأجهزة المدعومة"
            >
              SUPPORTED PLATFORMS
            </span>

            <h2
              data-en="Enjoy on your favorite devices"
              data-ar="استمتع على أجهزتك المفضلة"
            >
              Enjoy on your favorite devices
            </h2>

            <p
              class="muted"
              data-en="Support varies by app, service and device model. Check compatibility before ordering."
              data-ar="يختلف الدعم حسب التطبيق والخدمة وطراز الجهاز. تحقق من التوافق قبل الطلب."
            >
              Support varies by app, service and device model.
              Check compatibility before ordering.
            </p>
          </div>
        </div>

        <div class="device-grid">
          {
            [
              ['📱', 'Android'],
              ['📺', 'Android TV'],
              ['🍎', 'iPhone / iPad'],
              ['🖥️', 'Windows'],
              ['🔥', 'Fire TV'],
              ['📺', 'Smart TV'],
              ['🎮', 'Xbox / Console'],
              ['▶', 'VLC'],
              ['📦', 'TV Box'],
              ['💻', 'Mac / Laptop']
            ].map(([icon, label]) => (
              <div class="device-item reveal">
                <span aria-hidden="true">{icon}</span>
                <strong>{label}</strong>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section">
    <div class="container">
      <div class="cta">
        <div>
          <h2
            data-en="Need help choosing?"
            data-ar="تحتاج مساعدة في الاختيار؟"
          >
            Need help choosing?
          </h2>

          <p
            data-en="Tell us your device and what you're looking for."
            data-ar="أخبرنا بنوع جهازك وما تحتاجه وسنساعدك."
          >
            Tell us your device and what you're looking for.
          </p>
        </div>

        <a
          class="btn"
          href={genericWhatsapp('Hello NASA IPTV, I need help choosing a product.')}
          target="_blank"
          rel="noopener noreferrer"
          data-en="Chat on WhatsApp ↗"
          data-ar="تواصل عبر واتساب ↗"
        >
          Chat on WhatsApp ↗
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 24px 0 36px;
  }

  .hero-visual .nasa-tv {
    position: relative;
    width: 100%;
    max-width: 590px;
    padding: 8px;
    border: 2px solid rgba(94, 167, 239, 0.7);
    border-radius: 20px;
    background: linear-gradient(145deg, #294e78, #071426);
    box-shadow:
      0 28px 65px rgba(0, 0, 0, 0.45),
      0 0 40px rgba(0, 145, 255, 0.18),
      inset 0 1px 2px rgba(255, 255, 255, 0.25);
    transform: none;
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }

  .hero-visual .nasa-tv:hover {
    transform: translateY(-5px);
    box-shadow:
      0 36px 75px rgba(0, 0, 0, 0.5),
      0 0 50px rgba(0, 145, 255, 0.3);
  }

  .nasa-tv-screen {
    width: 100%;
    aspect-ratio: 1308 / 733;
    overflow: hidden;
    border-radius: 12px;
    background: #020914;
  }

  .nasa-tv-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nasa-tv-stand {
    position: absolute;
    left: 50%;
    bottom: -24px;
    width: 29%;
    height: 24px;
    transform: translateX(-50%);
    background: linear-gradient(#3d648e, #091829);
    clip-path: polygon(
      39% 0,
      61% 0,
      75% 80%,
      100% 100%,
      0 100%,
      25% 80%
    );
  }

  @media (max-width: 760px) {
    .hero-visual {
      padding: 12px 0 28px;
    }

    .hero-visual .nasa-tv {
      max-width: 100%;
      padding: 5px;
      border-radius: 13px;
    }

    .nasa-tv-screen {
      border-radius: 8px;
    }

    .nasa-tv-stand {
      bottom: -17px;
      height: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual .nasa-tv {
      transition: none;
    }

    .hero-visual .nasa-tv:hover {
      transform: none;
    }
  }
</style>
