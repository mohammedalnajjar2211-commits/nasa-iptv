
---
import Base from '../../layouts/Base.astro';

const apiUrl = 'https://nasa-matches-api.mohammedalnajjar2211.workers.dev';
---

<Base
  title="Football Matches & Scores | NASA IPTV"
  description="Explore football fixtures, scores and match times from leagues worldwide. Automatically displayed in your local time zone."
  canonical="/matches/"
>
  <section class="matches-page">
    <div class="container">
      <div class="matches-hero">
        <div class="matches-eyebrow">NASA IPTV · FOOTBALL CENTER</div>
        <h1 data-en="Football Matches & Scores" data-ar="مباريات كرة القدم والنتائج">
          Football Matches & Scores
        </h1>
        <p
          data-en="Explore football fixtures, results and scores from leagues worldwide."
          data-ar="تابع مواعيد مباريات كرة القدم والنتائج من مختلف البطولات العالمية."
        >
          Explore football fixtures, results and scores from leagues worldwide.
        </p>
      </div>

      <div class="matches-toolbar">
        <div class="matches-days" role="group" aria-label="Match day">
          <button type="button" data-match-day="yesterday" data-en="Yesterday" data-ar="أمس">Yesterday</button>
          <button type="button" data-match-day="today" class="active" data-en="Today" data-ar="اليوم">Today</button>
          <button type="button" data-match-day="tomorrow" data-en="Tomorrow" data-ar="غداً">Tomorrow</button>
        </div>

        <input
          id="matches-search"
          type="search"
          placeholder="Search teams or leagues..."
          aria-label="Search teams or leagues"
        />
      </div>

      <div class="matches-timebar">
        <div class="matches-time-label">
          <span aria-hidden="true">◷</span>
          <span id="matches-time-description"></span>
        </div>

        <select id="matches-timezone" aria-label="Match time zone">
          <option value="local">Local time</option>
          <option value="Asia/Baghdad">Baghdad (UTC+3)</option>
        </select>
      </div>

      <div class="matches-meta">
        <span id="matches-count"></span>
        <span id="matches-updated"></span>
      </div>

      <div id="matches-content" aria-live="polite">
        <div class="matches-state">Loading matches...</div>
      </div>
    </div>
  </section>

  <style>
    .matches-page {
      padding: 35px 0 75px;
      min-height: 65vh;
    }

    .matches-hero {
      text-align: center;
      padding: 25px 0 38px;
    }

    .matches-eyebrow {
      color: #ff5365;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 14px;
    }

    .matches-hero h1 {
      font-size: clamp(28px, 4vw, 46px);
      line-height: 1.2;
      margin: 0 0 14px;
    }

    .matches-hero p {
      max-width: 650px;
      margin: 0 auto;
      color: #aebdd4;
      line-height: 1.8;
    }

    .matches-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 16px;
    }

    .matches-days {
      display: flex;
      gap: 5px;
      padding: 5px;
      border-radius: 12px;
      background: #101b35;
      border: 1px solid #ffffff1a;
    }

    .matches-days button {
      padding: 12px 20px;
      border: 0;
      border-radius: 8px;
      color: #b6c7e2;
      background: transparent;
      font-weight: 700;
      cursor: pointer;
    }

    .matches-days button.active {
      background: #e83149;
      color: white;
    }

    #matches-search {
      width: min(330px, 100%);
      background: #101b35;
      border: 1px solid #ffffff24;
      color: white;
      border-radius: 10px;
      padding: 13px 15px;
      outline: none;
    }

    #matches-search:focus {
      border-color: #ff5266;
    }

    .matches-timebar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      background: #102447;
      border: 1px solid #31517d;
      border-radius: 11px;
      padding: 12px 16px;
      margin-bottom: 17px;
    }

    .matches-time-label {
      color: #d6e6ff;
      font-size: 13px;
    }

    #matches-timezone {
      background: #0a1730;
      color: #fff;
      border: 1px solid #42608a;
      border-radius: 8px;
      padding: 9px 12px;
    }

    .matches-meta {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      color: #a8b9d2;
      font-size: 13px;
      margin-bottom: 17px;
    }

    .matches-state {
      text-align: center;
      background: #101b35;
      border: 1px solid #ffffff1a;
      border-radius: 14px;
      padding: 38px 18px;
      color: #bdcbe0;
    }

    .matches-retry {
      margin-top: 15px;
      border: 0;
      background: #e83149;
      color: white;
      padding: 11px 19px;
      border-radius: 8px;
      cursor: pointer;
    }

    /* Dynamic match elements created by JavaScript */
    :global(.nasa-match-league) {
      background: #101b35;
      border: 1px solid #ffffff1c;
      border-radius: 14px;
      margin-bottom: 16px;
      overflow: hidden;
    }

    :global(.nasa-match-league-head) {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 17px;
      background: #182c50;
      border-bottom: 1px solid #ffffff14;
    }

    :global(.nasa-match-league-logo) {
      width: 30px !important;
      height: 30px !important;
      max-width: 30px !important;
      max-height: 30px !important;
      object-fit: contain;
      flex: 0 0 30px;
    }

    :global(.nasa-match-league-name) {
      font-weight: 800;
      font-size: 14px;
      color: #fff;
    }

    :global(.nasa-match-league-country) {
      font-size: 11px;
      color: #a4b7d2;
      margin-top: 3px;
    }

    :global(.nasa-match-row) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 120px minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      padding: 15px 20px;
      border-bottom: 1px solid #ffffff10;
    }

    :global(.nasa-match-row:last-child) {
      border-bottom: 0;
    }

    :global(.nasa-match-team) {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    :global(.nasa-match-home) {
      justify-content: flex-end;
    }

    :global(.nasa-match-away) {
      justify-content: flex-start;
    }

    :global(.nasa-match-team-name) {
      color: #f4f7ff;
      font-weight: 700;
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    :global(.nasa-match-home .nasa-match-team-name) {
      text-align: end;
    }

    :global(.nasa-match-team-logo) {
      width: 34px !important;
      height: 34px !important;
      max-width: 34px !important;
      max-height: 34px !important;
      object-fit: contain;
      flex: 0 0 34px;
    }

    :global(.nasa-match-center) {
      text-align: center;
      min-width: 0;
    }

    :global(.nasa-match-score) {
      font-size: 20px;
      font-weight: 900;
      color: #fff;
      white-space: nowrap;
    }

    :global(.nasa-match-status) {
      font-size: 11px;
      color: #a9bad3;
      margin-top: 5px;
      line-height: 1.4;
    }

    :global(.nasa-match-status.is-live) {
      color: #ff5266;
      font-weight: 800;
    }

    @media (max-width: 650px) {
      .matches-page {
        padding: 16px 0 45px;
      }

      .matches-hero {
        padding: 25px 0;
      }

      .matches-toolbar {
        flex-direction: column;
        align-items: stretch;
      }

      .matches-days,
      #matches-search {
        width: 100%;
      }

      .matches-days button {
        flex: 1;
        padding: 11px 5px;
        font-size: 12px;
      }

      .matches-timebar {
        align-items: stretch;
      }

      #matches-timezone {
        width: 100%;
      }

      :global(.nasa-match-row) {
        grid-template-columns: minmax(0, 1fr) 78px minmax(0, 1fr);
        gap: 5px;
        padding: 13px 8px;
      }

      :global(.nasa-match-team) {
        gap: 5px;
      }

      :global(.nasa-match-team-logo) {
        width: 26px !important;
        height: 26px !important;
        max-width: 26px !important;
        max-height: 26px !important;
        flex-basis: 26px;
      }

      :global(.nasa-match-team-name) {
        font-size: 11px;
      }

      :global(.nasa-match-score) {
        font-size: 17px;
      }

      :global(.nasa-match-status) {
        font-size: 10px;
      }
    }
  </style>

  <script define:vars={{ apiUrl }}>
    const content = document.getElementById('matches-content');
    const count = document.getElementById('matches-count');
    const updated = document.getElementById('matches-updated');
    const search = document.getElementById('matches-search');
    const zoneSelect = document.getElementById('matches-timezone');
    const timeDescription = document.getElementById('matches-time-description');

    const localZone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';

    const language = () =>
      document.documentElement.dataset.lang === 'ar' ? 'ar' : 'en';

    const words = {
      en: {
        loading: 'Loading matches...',
        empty: 'No matches found.',
        unavailable: 'Match data is temporarily unavailable.',
        retry: 'Try again',
        search: 'Search teams or leagues...',
        matches: 'matches',
        updated: 'Last updated',
        local: 'Local time',
        baghdad: 'Baghdad time (UTC+3)',
        using: 'Match times shown in',
        finished: 'Full time',
        halftime: 'Half time',
        live: 'LIVE',
        postponed: 'Postponed',
        cancelled: 'Cancelled',
        upcoming: 'Upcoming'
      },
      ar: {
        loading: 'جارٍ تحميل المباريات...',
        empty: 'لا توجد مباريات مطابقة.',
        unavailable: 'بيانات المباريات غير متاحة مؤقتاً.',
        retry: 'إعادة المحاولة',
        search: 'ابحث عن فريق أو بطولة...',
        matches: 'مباراة',
        updated: 'آخر تحديث',
        local: 'توقيت جهازك',
        baghdad: 'توقيت بغداد (UTC+3)',
        using: 'تُعرض مواعيد المباريات حسب',
        finished: 'انتهت المباراة',
        halftime: 'استراحة',
        live: 'مباشر',
        postponed: 'مؤجلة',
        cancelled: 'ملغاة',
        upcoming: 'لم تبدأ'
      }
    };

    const t = key => words[language()][key] || key;

    const priority = new Map([
      [2, 1], [3, 2], [39, 3], [140, 4],
      [135, 5], [78, 6], [61, 7], [307, 8],
      [253, 9]
    ]);

    const liveStatuses = new Set([
      '1H', '2H', 'ET', 'BT', 'P', 'LIVE', 'INT'
    ]);

    const finishedStatuses = new Set(['FT', 'AET', 'PEN']);

    let day = 'today';
    let fixtures = [];
    let lastUpdated = '';
    let requestNumber = 0;
    let state = 'loading';

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[character]);
    }

    function selectedZone() {
      return zoneSelect.value === 'Asia/Baghdad'
        ? 'Asia/Baghdad'
        : localZone;
    }

    function formatTime(value) {
      if (!value) return '—';

      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '—';

      return new Intl.DateTimeFormat(
        language() === 'ar' ? 'ar-IQ' : 'en-GB',
        {
          timeZone: selectedZone(),
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        }
      ).format(date);
    }

    function localDate(offset = 0) {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: selectedZone(),
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).formatToParts(new Date());

      const values = Object.fromEntries(
        parts.map(part => [part.type, part.value])
      );

      return new Date(Date.UTC(
        Number(values.year),
        Number(values.month) - 1,
        Number(values.day) + offset
      )).toISOString().slice(0, 10);
    }

    function dateInZone(value) {
      const date = new Date(value);

      if (Number.isNaN(date.getTime())) return '';

      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: selectedZone(),
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).formatToParts(date);

      const values = Object.fromEntries(
        parts.map(part => [part.type, part.value])
      );

      return `${values.year}-${values.month}-${values.day}`;
    }

    function dayOffset() {
      return day === 'yesterday' ? -1 : day === 'tomorrow' ? 1 : 0;
    }

    function matchStatus(match) {
      if (liveStatuses.has(match.status)) {
        return match.elapsed
          ? `${match.elapsed}' · ${t('live')}`
          : t('live');
      }

      if (match.status === 'HT') return t('halftime');
      if (finishedStatuses.has(match.status)) return t('finished');
      if (match.status === 'PST') return t('postponed');
      if (match.status === 'CANC') return t('cancelled');

      return formatTime(match.date);
    }

    function matchCard(match) {
      const home = match.home || {};
      const away = match.away || {};

      const started = liveStatuses.has(match.status) ||
        finishedStatuses.has(match.status) ||
        match.status === 'HT';

      const score = started
        ? `${home.goals ?? '–'} - ${away.goals ?? '–'}`
        : 'VS';

      const live = liveStatuses.has(match.status);

      return `
        <div class="nasa-match-row">
          <div class="nasa-match-team nasa-match-home">
            <span class="nasa-match-team-name">${escapeHtml(home.name)}</span>
            <img class="nasa-match-team-logo"
              src="${escapeHtml(home.logo || '')}"
              alt=""
              loading="lazy">
          </div>

          <div class="nasa-match-center">
            <div class="nasa-match-score">${escapeHtml(score)}</div>
            <div class="nasa-match-status ${live ? 'is-live' : ''}">
              ${escapeHtml(matchStatus(match))}
            </div>
          </div>

          <div class="nasa-match-team nasa-match-away">
            <img class="nasa-match-team-logo"
              src="${escapeHtml(away.logo || '')}"
              alt=""
              loading="lazy">
            <span class="nasa-match-team-name">${escapeHtml(away.name)}</span>
          </div>
        </div>
      `;
    }

    function updateTimezoneText() {
      const zone = selectedZone();

      const readable = zone === 'Asia/Baghdad'
        ? t('baghdad')
        : `${t('local')} (${zone.replaceAll('_', ' ')})`;

      timeDescription.textContent = `${t('using')} ${readable}`;

      zoneSelect.options[0].textContent = t('local');
      zoneSelect.options[1].textContent = t('baghdad');
    }

    function render() {
      updateTimezoneText();
      search.placeholder = t('search');

      if (state === 'loading') {
        content.innerHTML =
          `<div class="matches-state">${escapeHtml(t('loading'))}</div>`;
        return;
      }

      if (state === 'error') {
        count.textContent = '';
        updated.textContent = '';

        content.innerHTML = `
          <div class="matches-state">
            ${escapeHtml(t('unavailable'))}
            <div>
              <button type="button" class="matches-retry" id="matches-retry">
                ${escapeHtml(t('retry'))}
              </button>
            </div>
          </div>
        `;

        document.getElementById('matches-retry')
          ?.addEventListener('click', loadMatches);
        return;
      }

      const query = search.value.trim().toLocaleLowerCase();
      const selectedDate = localDate(dayOffset());

      const filtered = fixtures.filter(match => {
        const haystack = [
          match.home?.name,
          match.away?.name,
          match.league?.name,
          match.league?.country
        ].join(' ').toLocaleLowerCase();

        return haystack.includes(query) &&
          dateInZone(match.date) === selectedDate;
      });

      count.textContent = `${filtered.length.toLocaleString()} ${t('matches')}`;

      updated.textContent = lastUpdated
        ? `${t('updated')}: ${formatTime(lastUpdated)}`
        : '';

      if (!filtered.length) {
        content.innerHTML =
          `<div class="matches-state">${escapeHtml(t('empty'))}</div>`;
        return;
      }

      const groups = new Map();

      for (const match of filtered) {
        const league = match.league || {};
        const key = String(league.id ?? league.name ?? 'other');

        if (!groups.has(key)) {
          groups.set(key, { league, matches: [] });
        }

        groups.get(key).matches.push(match);
      }

      const sorted = [...groups.values()].sort((a, b) => {
        const first = priority.get(Number(a.league.id)) ?? 999;
        const second = priority.get(Number(b.league.id)) ?? 999;

        return first - second ||
          String(a.league.name || '').localeCompare(
            String(b.league.name || '')
          );
      });

      content.innerHTML = sorted.map(group => {
        const orderedMatches = group.matches.sort(
          (a, b) => (a.timestamp || 0) - (b.timestamp || 0)
        );

        return `
          <section class="nasa-match-league">
            <div class="nasa-match-league-head">
              <img class="nasa-match-league-logo"
                src="${escapeHtml(group.league.logo || '')}"
                alt=""
                loading="lazy">
              <div>
                <div class="nasa-match-league-name">
                  ${escapeHtml(group.league.name || '')}
                </div>
                <div class="nasa-match-league-country">
                  ${escapeHtml(group.league.country || '')}
                </div>
              </div>
            </div>
            ${orderedMatches.map(matchCard).join('')}
          </section>
        `;
      }).join('');
    }

    async function loadMatches() {
      const request = ++requestNumber;
      state = 'loading';
      render();

      try {
        // Adjacent Baghdad dates cover timezone differences.
        const days = ['yesterday', 'today', 'tomorrow'];

        const results = await Promise.all(
          days.map(async item => {
            const response = await fetch(
              `${apiUrl}/api/matches?day=${item}`
            );

            if (!response.ok) return null;
            return response.json();
          })
        );

        if (request !== requestNumber) return;

        const available = results.filter(Boolean);

        if (!available.length) throw new Error('No data');

        const unique = new Map();

        for (const result of available) {
          for (const match of result.matches || []) {
            unique.set(match.id, match);
          }
        }

        fixtures = [...unique.values()];

        lastUpdated = available
          .map(result => result.updated_at)
          .filter(Boolean)
          .sort()
          .at(-1) || '';

        state = 'ready';
        render();
      } catch {
        if (request !== requestNumber) return;
        state = 'error';
        render();
      }
    }

    document.querySelectorAll('[data-match-day]').forEach(button => {
      button.addEventListener('click', () => {
        day = button.dataset.matchDay;

        document.querySelectorAll('[data-match-day]').forEach(item => {
          item.classList.toggle('active', item === button);
        });

        render();
      });
    });

    search.addEventListener('input', render);
    zoneSelect.addEventListener('change', render);

    // React to the existing NASA language picker.
    const languageObserver = new MutationObserver(render);

    languageObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-lang']
    });

    loadMatches();

    // Refresh from Cloudflare KV every five minutes.
    setInterval(loadMatches, 5 * 60 * 1000);
  </script>
</Base>
