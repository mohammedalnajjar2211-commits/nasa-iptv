
---
const apiUrl = "https://nasa-matches-api.mohammedalnajjar2211.workers.dev";
---

<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Today's Football Matches & Live Scores | NASA IPTV</title>
  <meta name="description" content="Explore today's football matches, live scores, fixtures, results and kickoff times across international football leagues on NASA IPTV." />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href="https://nasa-iptv.net/matches/" />
  <meta name="theme-color" content="#090c15" />

  <link rel="preconnect" href="https://media.api-sports.io" crossorigin />

  <style>
    :root {
      color-scheme: dark;
      font-family: Arial, Helvetica, sans-serif;
      background: #090c15;
      color: #f5f6fa;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% -10%, #25315a 0%, transparent 50%),
        #090c15;
    }

    button, input { font: inherit; }

    button { cursor: pointer; }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, calc(100% - 32px));
      margin-inline: auto;
    }

    .header {
      border-bottom: 1px solid #ffffff13;
      background: #0b0e19e8;
    }

    .header-inner {
      min-height: 76px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .brand {
      font-size: 21px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .brand span { color: #ff3b49; }

    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .header-link, .language-button {
      padding: 10px 14px;
      border: 1px solid #ffffff20;
      border-radius: 10px;
      background: #151a2a;
      color: white;
      font-size: 13px;
    }

    .language-button { font-weight: 700; }

    .hero {
      padding: 58px 0 32px;
      text-align: center;
    }

    .eyebrow {
      color: #ff5360;
      font-size: 12px;
      letter-spacing: 2px;
      font-weight: 800;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(29px, 5vw, 49px);
      line-height: 1.15;
      margin: 15px 0;
      letter-spacing: -1.3px;
    }

    .hero p {
      max-width: 650px;
      margin: auto;
      color: #a4aec5;
      line-height: 1.8;
      font-size: 15px;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      margin: 18px 0 22px;
    }

    .days {
      display: flex;
      gap: 7px;
      padding: 5px;
      border: 1px solid #ffffff15;
      background: #111624;
      border-radius: 13px;
    }

    .day {
      border: 0;
      background: transparent;
      color: #a7afc3;
      padding: 12px 19px;
      border-radius: 9px;
      font-size: 13px;
      font-weight: 700;
    }

    .day.active {
      color: #fff;
      background: #e62e42;
      box-shadow: 0 4px 18px #e62e4238;
    }

    .search {
      width: min(320px, 100%);
      background: #141a29;
      border: 1px solid #ffffff1c;
      border-radius: 12px;
      color: white;
      padding: 14px 16px;
      outline: none;
    }

    .search:focus { border-color: #e62e42; }

    .info {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 17px;
      color: #9ca6bc;
      font-size: 13px;
    }

    .live-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ff4052;
      box-shadow: 0 0 12px #ff4052;
      margin-inline-end: 5px;
    }

    .league {
      border: 1px solid #ffffff14;
      border-radius: 15px;
      background: #111625;
      margin-bottom: 17px;
      overflow: hidden;
    }

    .league-head {
      display: flex;
      align-items: center;
      gap: 11px;
      background: #192033;
      border-bottom: 1px solid #ffffff10;
      padding: 15px 19px;
    }

    .league-logo {
      width: 31px;
      height: 31px;
      object-fit: contain;
    }

    .league-name {
      font-weight: 800;
      font-size: 14px;
    }

    .league-country {
      color: #929eb7;
      font-size: 11px;
      margin-top: 4px;
    }

    .match {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 115px minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      padding: 18px 22px;
      border-bottom: 1px solid #ffffff0e;
    }

    .match:last-child { border-bottom: 0; }

    .team {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
    }

    .team.home { justify-content: flex-end; }
    .team.away { justify-content: flex-start; }

    .team-name {
      font-size: 13px;
      font-weight: 700;
      overflow-wrap: anywhere;
    }

    .team.home .team-name { text-align: end; }

    .team-logo {
      width: 37px;
      height: 37px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .score-box { text-align: center; }

    .score {
      font-size: 21px;
      font-weight: 900;
      letter-spacing: 1px;
      white-space: nowrap;
    }

    .status {
      font-size: 10px;
      margin-top: 6px;
      color: #9ba6bf;
    }

    .status.live {
      color: #ff5868;
      font-weight: 800;
    }

    .state {
      text-align: center;
      border: 1px solid #ffffff16;
      background: #121827;
      padding: 42px 20px;
      border-radius: 15px;
      color: #abb5c9;
      line-height: 1.8;
    }

    .state strong {
      color: white;
      display: block;
      margin-bottom: 7px;
    }

    .retry {
      margin-top: 15px;
      padding: 11px 20px;
      border-radius: 9px;
      background: #e62e42;
      border: 0;
      color: white;
      font-weight: 700;
    }

    .footer {
      margin-top: 60px;
      border-top: 1px solid #ffffff12;
      padding: 30px 0;
      color: #8c97ad;
      text-align: center;
      font-size: 12px;
    }

    [hidden] { display: none !important; }

    @media (max-width: 650px) {
      .header-inner { min-height: 65px; }
      .brand { font-size: 17px; }
      .header-link { padding: 9px; font-size: 11px; }
      .hero { padding: 37px 0 25px; }
      .toolbar { flex-direction: column; align-items: stretch; }
      .days { width: 100%; }
      .day { flex: 1; padding: 12px 5px; }
      .search { width: 100%; }
      .match {
        grid-template-columns: minmax(0, 1fr) 80px minmax(0, 1fr);
        gap: 5px;
        padding: 16px 9px;
      }
      .team { gap: 5px; }
      .team-logo { width: 27px; height: 27px; }
      .team-name { font-size: 11px; }
      .score { font-size: 17px; }
      .league-head { padding: 12px; }
    }
  </style>
</head>

<body>
  <header class="header">
    <div class="container header-inner">
      <a class="brand" href="/">NASA <span>IPTV</span></a>

      <div class="header-actions">
        <a class="header-link" href="/" id="homeLink">Home</a>
        <button class="language-button" id="langButton" type="button">العربية</button>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <div class="eyebrow">NASA IPTV · FOOTBALL CENTER</div>
      <h1 id="pageTitle">Football Matches & Live Scores</h1>
      <p id="pageSubtitle">
        Follow fixtures, match results and scores from football leagues worldwide.
      </p>
    </section>

    <section aria-label="Football fixtures">
      <div class="toolbar">
        <div class="days" role="group" aria-label="Select match day">
          <button class="day" data-day="yesterday" type="button" id="yesterdayButton">Yesterday</button>
          <button class="day active" data-day="today" type="button" id="todayButton">Today</button>
          <button class="day" data-day="tomorrow" type="button" id="tomorrowButton">Tomorrow</button>
        </div>

        <input
          class="search"
          type="search"
          id="search"
          placeholder="Search teams or leagues..."
          aria-label="Search matches"
        />
      </div>

      <div class="info">
        <span id="matchCount">Loading matches...</span>
        <span id="lastUpdated"></span>
      </div>

      <div id="matches" aria-live="polite">
        <div class="state">Loading football matches...</div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      © {new Date().getFullYear()} NASA IPTV · Football Match Center
    </div>
  </footer>

  <script define:vars={{ apiUrl }}>
    const translations = {
      en: {
        title: "Football Matches & Live Scores",
        subtitle: "Follow fixtures, match results and scores from football leagues worldwide.",
        yesterday: "Yesterday",
        today: "Today",
        tomorrow: "Tomorrow",
        search: "Search teams or leagues...",
        loading: "Loading football matches...",
        unavailable: "Matches are temporarily unavailable.",
        empty: "No matches found.",
        retry: "Try again",
        matches: "matches",
        updated: "Last updated",
        home: "Home",
        live: "LIVE",
        finished: "Full time",
        upcoming: "Upcoming",
        postponed: "Postponed",
        cancelled: "Cancelled",
        halftime: "Half time",
        timezone: "Baghdad time",
        notReady: "Match data is being prepared. Please check back shortly."
      },
      ar: {
        title: "مباريات اليوم والنتائج المباشرة",
        subtitle: "تابع مواعيد مباريات كرة القدم والنتائج والبطولات العالمية في مكان واحد.",
        yesterday: "أمس",
        today: "اليوم",
        tomorrow: "غداً",
        search: "ابحث عن فريق أو بطولة...",
        loading: "جارٍ تحميل المباريات...",
        unavailable: "المباريات غير متاحة مؤقتاً.",
        empty: "لا توجد مباريات مطابقة.",
        retry: "إعادة المحاولة",
        matches: "مباراة",
        updated: "آخر تحديث",
        home: "الرئيسية",
        live: "مباشر",
        finished: "انتهت",
        upcoming: "لم تبدأ",
        postponed: "مؤجلة",
        cancelled: "ملغاة",
        halftime: "استراحة",
        timezone: "بتوقيت بغداد",
        notReady: "يجري تجهيز بيانات المباريات، يرجى المحاولة بعد قليل."
      }
    };

    const priorityLeagues = new Map([
      [2, 1],
      [3, 2],
      [39, 3],
      [140, 4],
      [135, 5],
      [78, 6],
      [61, 7],
      [307, 8],
      [253, 9]
    ]);

    const elements = {
      title: document.getElementById("pageTitle"),
      subtitle: document.getElementById("pageSubtitle"),
      yesterday: document.getElementById("yesterdayButton"),
      today: document.getElementById("todayButton"),
      tomorrow: document.getElementById("tomorrowButton"),
      search: document.getElementById("search"),
      matches: document.getElementById("matches"),
      count: document.getElementById("matchCount"),
      updated: document.getElementById("lastUpdated"),
      lang: document.getElementById("langButton"),
      home: document.getElementById("homeLink")
    };

    let language = "en";
    let selectedDay = "today";
    let fixtures = [];
    let lastUpdated = "";
    let loading = false;
    let requestId = 0;

    const liveStatuses = new Set([
      "1H", "2H", "ET", "BT", "P", "LIVE", "INT"
    ]);

    const finishedStatuses = new Set([
      "FT", "AET", "PEN"
    ]);

    function t(key) {
      return translations[language][key] || key;
    }

    function safe(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function formatTime(dateString) {
      if (!dateString) return "—";

      const date = new Date(dateString);

      if (Number.isNaN(date.getTime())) return "—";

      return new Intl.DateTimeFormat(
        language === "ar" ? "ar-IQ" : "en-GB",
        {
          timeZone: "Asia/Baghdad",
          hour: "2-digit",
          minute: "2-digit",
          hour12: true
        }
      ).format(date);
    }

    function statusText(match) {
      const status = match.status || "NS";

      if (liveStatuses.has(status)) {
        if (status === "P") return t("live");

        return match.elapsed
          ? `${match.elapsed}' · ${t("live")}`
          : t("live");
      }

      if (status === "HT") return t("halftime");
      if (finishedStatuses.has(status)) return t("finished");
      if (status === "PST") return t("postponed");
      if (status === "CANC") return t("cancelled");

      return `${formatTime(match.date)} · ${t("timezone")}`;
    }

    function matchHtml(match) {
      const home = match.home || {};
      const away = match.away || {};

      const started =
        liveStatuses.has(match.status) ||
        finishedStatuses.has(match.status) ||
        match.status === "HT";

      const score = started
        ? `${home.goals ?? "–"} : ${away.goals ?? "–"}`
        : "VS";

      const live = liveStatuses.has(match.status);

      return `
        <div class="match">
          <div class="team home">
            <span class="team-name">${safe(home.name)}</span>
            <img class="team-logo"
              src="${safe(home.logo)}"
              alt=""
              loading="lazy"
              referrerpolicy="no-referrer">
          </div>

          <div class="score-box">
            <div class="score">${safe(score)}</div>
            <div class="status ${live ? "live" : ""}">
              ${live ? '<span class="live-dot"></span>' : ""}
              ${safe(statusText(match))}
            </div>
          </div>

          <div class="team away">
            <img class="team-logo"
              src="${safe(away.logo)}"
              alt=""
              loading="lazy"
              referrerpolicy="no-referrer">
            <span class="team-name">${safe(away.name)}</span>
          </div>
        </div>
      `;
    }

    function leagueRank(league) {
      return priorityLeagues.get(Number(league.id)) ?? 999;
    }

    function render() {
      if (loading) {
        elements.matches.innerHTML =
          `<div class="state">${safe(t("loading"))}</div>`;
        return;
      }

      const search = elements.search.value
        .trim()
        .toLocaleLowerCase();

      const filtered = fixtures.filter(match => {
        const text = [
          match.home?.name,
          match.away?.name,
          match.league?.name,
          match.league?.country
        ].join(" ").toLocaleLowerCase();

        return text.includes(search);
      });

      elements.count.textContent =
        `${filtered.length.toLocaleString(language === "ar" ? "ar-IQ" : "en-US")} ${t("matches")}`;

      elements.updated.textContent = lastUpdated
        ? `${t("updated")}: ${formatTime(lastUpdated)}`
        : "";

      if (!filtered.length) {
        elements.matches.innerHTML =
          `<div class="state">${safe(t("empty"))}</div>`;
        return;
      }

      const groups = new Map();

      for (const match of filtered) {
        const league = match.league || {};
        const key = String(league.id ?? league.name ?? "other");

        if (!groups.has(key)) {
          groups.set(key, {
            league,
            matches: []
          });
        }

        groups.get(key).matches.push(match);
      }

      const sortedGroups = [...groups.values()].sort((a, b) => {
        const rankDifference =
          leagueRank(a.league) - leagueRank(b.league);

        if (rankDifference !== 0) return rankDifference;

        return String(a.league.name || "").localeCompare(
          String(b.league.name || "")
        );
      });

      elements.matches.innerHTML = sortedGroups.map(group => {
        const matches = group.matches.sort(
          (a, b) => (a.timestamp || 0) - (b.timestamp || 0)
        );

        return `
          <section class="league">
            <div class="league-head">
              <img class="league-logo"
                src="${safe(group.league.logo || "")}"
                alt=""
                loading="lazy">
              <div>
                <div class="league-name">${safe(group.league.name || "")}</div>
                <div class="league-country">${safe(group.league.country || "")}</div>
              </div>
            </div>
            ${matches.map(matchHtml).join("")}
          </section>
        `;
      }).join("");
    }

    async function loadMatches() {
      const currentRequest = ++requestId;
      loading = true;
      fixtures = [];
      lastUpdated = "";
      render();

      try {
        const response = await fetch(
          `${apiUrl}/api/matches?day=${encodeURIComponent(selectedDay)}`
        );

        if (!response.ok) {
          if (response.status === 503) {
            throw new Error("notReady");
          }
          throw new Error("unavailable");
        }

        const data = await response.json();

        if (currentRequest !== requestId) return;

        fixtures = Array.isArray(data.matches) ? data.matches : [];
        lastUpdated = data.updated_at || "";
        loading = false;
        render();
      } catch (error) {
        if (currentRequest !== requestId) return;

        loading = false;

        const message = error.message === "notReady"
          ? t("notReady")
          : t("unavailable");

        elements.count.textContent = "";
        elements.updated.textContent = "";

        elements.matches.innerHTML = `
          <div class="state">
            <strong>${safe(message)}</strong>
            <button class="retry" id="retryButton" type="button">
              ${safe(t("retry"))}
            </button>
          </div>
        `;

        document.getElementById("retryButton")
          ?.addEventListener("click", loadMatches);
      }
    }

    function updateLanguage() {
      const isArabic = language === "ar";

      document.documentElement.lang = language;
      document.documentElement.dir = isArabic ? "rtl" : "ltr";

      elements.title.textContent = t("title");
      elements.subtitle.textContent = t("subtitle");
      elements.yesterday.textContent = t("yesterday");
      elements.today.textContent = t("today");
      elements.tomorrow.textContent = t("tomorrow");
      elements.search.placeholder = t("search");
      elements.home.textContent = t("home");
      elements.lang.textContent = isArabic ? "English" : "العربية";

      render();
    }

    document.querySelectorAll("[data-day]").forEach(button => {
      button.addEventListener("click", () => {
        selectedDay = button.dataset.day;

        document.querySelectorAll("[data-day]").forEach(item => {
          item.classList.toggle(
            "active",
            item.dataset.day === selectedDay
          );
        });

        loadMatches();
      });
    });

    elements.search.addEventListener("input", render);

    elements.lang.addEventListener("click", () => {
      language = language === "en" ? "ar" : "en";
      updateLanguage();
    });

    updateLanguage();
    loadMatches();

    // Refresh displayed data every five minutes.
    // The Worker serves KV data; this does not call API-Football.
    setInterval(loadMatches, 5 * 60 * 1000);
  </script>
</body>
</html>
