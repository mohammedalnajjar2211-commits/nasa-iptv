---
import Base from '../layouts/Base.astro';
const title = 'Payment Instructions | NASA IPTV';
const description = 'Secure payment instructions, app downloads, and USD to IQD estimate.';
---
<Base title={title} description={description}>
  <section class="payment-wrap" id="payment-page">
    <div class="payment-head">
      <span class="eyebrow" data-en="PAYMENT GUIDE" data-ar="دليل الدفع">PAYMENT GUIDE</span>
      <h1 data-en="Complete your payment" data-ar="أكمل عملية الدفع">Complete your payment</h1>
      <p data-en="Follow the steps below using the official payment app. Keep your transfer receipt." data-ar="اتبع الخطوات التالية باستخدام تطبيق الدفع الرسمي، واحتفظ بإيصال التحويل.">Follow the steps below using the official payment app. Keep your transfer receipt.</p>
    </div>

    <div class="payment-grid">
      <div class="payment-card">
        <h2 data-en="1. Install the app" data-ar="١. تثبيت التطبيق">1. Install the app</h2>
        <div class="app-links">
          <a href="https://apps.apple.com/app/id6746080459" target="_blank" rel="noopener noreferrer"> <span data-en="Download for iPhone" data-ar="تحميل للآيفون">Download for iPhone</span> ↗</a>
          <a href="https://play.google.com/store/apps/details?id=iq.qi.diz&amp;hl=ar" target="_blank" rel="noopener noreferrer">▶ <span data-en="Download for Android" data-ar="تحميل للأندرويد">Download for Android</span> ↗</a>
        </div>
        <h2 data-en="2. Start the transfer" data-ar="٢. ابدأ التحويل">2. Start the transfer</h2>
        <ol class="steps">
          <li data-en="Open the app and tap Start Transfer." data-ar="افتح التطبيق واضغط على «ابدأ التحويل».">Open the app and tap Start Transfer.</li>
          <li data-en="Enter the amount in Iraqi dinars, using the calculator below as an estimate." data-ar="أدخل المبلغ بالدينار العراقي، واستعن بالحاسبة أدناه للتقدير.">Enter the amount in Iraqi dinars, using the calculator below as an estimate.</li>
          <li data-en="Enter the recipient account number shown below." data-ar="أدخل رقم حساب المستلم الموضح أدناه.">Enter the recipient account number shown below.</li>
          <li data-en="Choose International Transfer if it is the appropriate transfer type offered by the app." data-ar="اختر «تحويل دولي» إذا كان هذا هو نوع التحويل المناسب الذي يتيحه التطبيق.">Choose International Transfer if it is the appropriate transfer type offered by the app.</li>
          <li data-en="Fill in the relationship and transfer purpose accurately, as required by the payment provider." data-ar="املأ صلة القرابة والغرض من التحويل بصدق وفق متطلبات مزوّد الدفع.">Fill in the relationship and transfer purpose accurately, as required by the payment provider.</li>
          <li data-en="Review the recipient, amount, fees, and exchange rate, then confirm payment." data-ar="راجع المستلم والمبلغ والرسوم وسعر الصرف، ثم أكمل الدفع.">Review the recipient, amount, fees, and exchange rate, then confirm payment.</li>
        </ol>
        <div class="account">
          <div><small data-en="Recipient account number" data-ar="رقم حساب المستلم">Recipient account number</small><strong id="recipient-account">5568931371</strong></div>
          <button id="copy-account" type="button" data-en="Copy number" data-ar="نسخ الرقم">Copy number</button>
        </div>
      </div>

      <div class="payment-side">
        <div class="payment-card calculator">
          <h2 data-en="USD → IQD calculator" data-ar="حاسبة الدولار إلى الدينار">USD → IQD calculator</h2>
          <p class="muted" data-en="Illustrative rate only — not a live exchange rate." data-ar="سعر تقديري فقط، وليس سعر صرف مباشراً.">Illustrative rate only — not a live exchange rate.</p>
          <label for="usd-amount" data-en="Amount (USD)" data-ar="المبلغ (دولار)">Amount (USD)</label>
          <input id="usd-amount" type="number" min="0" step="0.01" value="40" inputmode="decimal" />
          <label for="iqd-rate" data-en="Estimated IQD per USD (editable)" data-ar="سعر الدينار لكل دولار (قابل للتعديل)">Estimated IQD per USD (editable)</label>
          <input id="iqd-rate" type="number" min="1" step="1" value="1425" inputmode="decimal" />
          <div class="result"><small data-en="Estimated amount" data-ar="المبلغ التقريبي">Estimated amount</small><strong id="iqd-result">57,000 IQD</strong></div>
          <p class="muted" data-en="Final amount, fees and exchange rate are determined by the payment provider." data-ar="المبلغ النهائي والرسوم وسعر الصرف يحددها مزوّد الدفع.">Final amount, fees and exchange rate are determined by the payment provider.</p>
        </div>
        <div class="payment-card receipt">
          <h2 data-en="3. Send your payment receipt" data-ar="٣. أرسل صورة إيصال الدفع">3. Send your payment receipt</h2>
          <p data-en="Important: After completing the transfer, send a clear screenshot of the successful payment through our usual support channel. Hide your card number and any sensitive information." data-ar="مهم جداً: بعد إكمال التحويل، أرسل صورة واضحة لإيصال الدفع الناجح عبر قناة الدعم المعتادة. أخفِ رقم بطاقتك وأي معلومات حساسة.">Important: After completing the transfer, send a clear screenshot of the successful payment through our usual support channel. Hide your card number and any sensitive information.</p>
          <p class="secure" data-en="🔒 Your payment information should be handled securely. Both parties retain their applicable rights." data-ar="🔒 احرص على أمان معلومات الدفع. حقوق الطرفين محفوظة وفق الشروط والأنظمة المعمول بها.">🔒 Your payment information should be handled securely. Both parties retain their applicable rights.</p>
          <p class="muted" data-en="If your card is declined, try another card that belongs to you or contact your bank. Do not retry repeatedly if a charge is pending." data-ar="إذا رُفضت بطاقتك، جرّب بطاقة أخرى تخصك أو تواصل مع البنك. لا تكرر المحاولة إذا كانت هناك عملية معلّقة.">If your card is declined, try another card that belongs to you or contact your bank. Do not retry repeatedly if a charge is pending.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .payment-wrap{max-width:1160px;margin:0 auto;padding:64px 20px 90px;color:#edf5ff;direction:ltr}
  :global(html[dir="rtl"]) .payment-wrap{direction:rtl}
  .payment-head{text-align:center;margin-bottom:34px}.eyebrow{color:#63b7ff;letter-spacing:.14em;font-size:.75rem;font-weight:800}.payment-head h1{font-size:clamp(2rem,4vw,3.3rem);margin:12px 0}.payment-head p{color:#aabbd0;max-width:670px;margin:auto}
  .payment-grid{display:grid;grid-template-columns:1.18fr 1fr;gap:22px;align-items:start}.payment-side{display:grid;gap:22px}.payment-card{background:linear-gradient(145deg,#101e36,#091322);border:1px solid #284263;border-radius:20px;padding:27px;box-shadow:0 16px 40px #0003}.payment-card h2{font-size:1.3rem;margin:0 0 20px}.payment-card h2:not(:first-child){margin-top:30px}.app-links{display:flex;flex-wrap:wrap;gap:12px}.app-links a,.account button{background:#1679d5;color:white;text-decoration:none;padding:12px 17px;border:0;border-radius:10px;font-weight:700;cursor:pointer}.app-links a:hover,.account button:hover{background:#2793f8}.steps{padding-inline-start:22px;line-height:1.9;color:#d2ddeb}.steps li{padding-inline-start:5px;margin-bottom:9px}.account{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid #385779;background:#071121;border-radius:14px;padding:15px;margin-top:24px;flex-wrap:wrap}.account small,.result small{display:block;color:#a5bad1;margin-bottom:7px}.account strong{font-size:1.35rem;letter-spacing:.03em;direction:ltr;display:block}.calculator label{display:block;margin:16px 0 7px;font-size:.92rem;color:#d7e5f6}.calculator input{width:100%;box-sizing:border-box;border-radius:10px;padding:13px;background:#071121;border:1px solid #42638a;color:#fff;font-size:1.1rem}.result{margin-top:20px;background:#0b2b4b;border-radius:12px;padding:18px}.result strong{font-size:1.75rem;color:#8bd0ff;direction:ltr;display:block}.muted{font-size:.88rem;line-height:1.65;color:#aabbd0}.receipt p{line-height:1.8}.secure{padding:14px;border:1px solid #285e7a;border-radius:12px;background:#102c3c}
  @media(max-width:800px){.payment-grid{grid-template-columns:1fr}.payment-wrap{padding:40px 14px 80px}.payment-card{padding:20px}.app-links a{flex:1 1 170px;text-align:center}}
</style>
<script>
  const usd = document.getElementById('usd-amount');
  const rate = document.getElementById('iqd-rate');
  const output = document.getElementById('iqd-result');
  function calculate(){
    const amount = Number(usd?.value || 0);
    const exchange = Number(rate?.value || 0);
    if (output) output.textContent = `${new Intl.NumberFormat('en-US',{maximumFractionDigits:0}).format(Math.round(Math.max(0,amount)*Math.max(0,exchange)))} IQD`;
  }
  usd?.addEventListener('input',calculate);
  rate?.addEventListener('input',calculate);
  document.getElementById('copy-account')?.addEventListener('click', async () => {
    const button = document.getElementById('copy-account');
    try {
      await navigator.clipboard.writeText('5568931371');
      if (button) {
        const ar = document.documentElement.lang === 'ar';
        button.textContent = ar ? 'تم النسخ ✓' : 'Copied ✓';
        setTimeout(() => { button.textContent = ar ? 'نسخ الرقم' : 'Copy number'; }, 1700);
      }
    } catch { window.prompt('Copy account number:', '5568931371'); }
  });
</script>
