---
import Base from '../../layouts/Base.astro';import ProductCard from '../../components/ProductCard.astro';import {products,money,whatsapp} from '../../data/products.js';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{product:p}}))}
const {product:p}=Astro.props;const related=products.filter(x=>x.category===p.category&&x.slug!==p.slug).slice(0,3);
const jsonLd={"@context":"https://schema.org","@type":"Product",name:p.name,description:p.description,offers:{"@type":"Offer",priceCurrency:'USD',price:p.price,availability:'https://schema.org/InStock',url:new URL(Astro.url.pathname,Astro.site).href}};
---
<Base title={`${p.name} | NASA IPTV`} description={p.description}><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><section class="section"><div class="container"><p class="muted"><a href="/nasa-iptv/shop/" data-en="← Back to shop" data-ar="→ العودة للمتجر">← Back to shop</a></p><div class="product-detail"><div class="detail-visual reveal">{p.image?<img src={p.image?.startsWith('/') ? '/nasa-iptv' + p.image : p.image} alt={p.name} width="840" height="840"/>:<div class="product-placeholder"><span>NASA IPTV</span><strong>{p.lifetime?'LIFETIME':p.months+' MONTHS'}</strong><small>PREMIUM DIGITAL</small></div>}</div><div class="detail-content reveal"><span class="eyebrow" data-en={p.category==='activation'?'PLAYER ACTIVATION':'SUBSCRIPTION'} data-ar={p.category==='activation'?'تفعيل مشغل':'اشتراك'}>{p.category==='activation'?'PLAYER ACTIVATION':'SUBSCRIPTION'}</span><h1 data-en={p.name} data-ar={p.ar}>{p.name}</h1><p class="muted" data-en={p.description} data-ar={p.category==='activation'?'ترخيص تفعيل تطبيق المشغل فقط، دون اشتراك IPTV أو محتوى بث.':'اشتراك رقمي. يرجى تأكيد توافق جهازك وتفاصيل الخدمة قبل الشراء.'}>{p.description}</p><div class="detail-price">{money(p.price)}</div><div class="product-description"><h2 data-en="Product description" data-ar="وصف المنتج">Product description</h2><p data-en={p.description} data-ar={p.category==='activation'?'ترخيص تفعيل للمشغل دون قنوات أو اشتراك IPTV. يرجى مراجعة توافق جهازك قبل الشراء.':'باقة اشتراك رقمية. تواصل معنا لمعرفة تفاصيل الخدمة والتوافق قبل إتمام الطلب.'}>{p.description}</p><p data-en="Order directly through WhatsApp. We will confirm availability, device compatibility and activation steps before payment." data-ar="اطلب مباشرة عبر واتساب وسنؤكد التوفر وتوافق الجهاز وخطوات التفعيل قبل الدفع.">Order directly through WhatsApp. We will confirm availability, device compatibility and activation steps before payment.</p></div><ul class="detail-list"><li data-en="Digital product" data-ar="منتج رقمي">Digital product</li><li data-en="Order and activation assistance via WhatsApp" data-ar="الطلب والمساعدة في التفعيل عبر واتساب">Order and activation assistance via WhatsApp</li><li data-en={p.lifetime?'Lifetime license (provider terms apply)':p.months+'-month term'} data-ar={p.lifetime?'ترخيص مدى الحياة وفق شروط المزود':`مدة ${p.months} أشهر`}>{p.lifetime?'Lifetime license (provider terms apply)':p.months+'-month term'}</li><li data-en="Confirm device compatibility before ordering" data-ar="تأكد من توافق جهازك قبل الطلب">Confirm device compatibility before ordering</li></ul><a class="btn" href={whatsapp(p)} target="_blank" rel="noopener" data-en="Order via WhatsApp ↗" data-ar="اطلب عبر واتساب ↗">Order via WhatsApp ↗</a><p class="muted" style="font-size:12px" data-en="You will be redirected to WhatsApp. No online payment is collected here." data-ar="سيتم تحويلك إلى واتساب. لا يتم تحصيل أي دفع داخل الموقع.">You will be redirected to WhatsApp. No online payment is collected here.</p></div></div></div></section>
<section class="section features"><div class="container"><h2 data-en="How to order" data-ar="طريقة الطلب">How to order</h2><div class="grid"><div class="step"><strong>01</strong><h3 data-en="Choose your product" data-ar="اختر المنتج">Choose your product</h3><p class="muted" data-en="Check the plan, price and compatibility." data-ar="راجع المدة والسعر وتوافق جهازك.">Check the plan, price and compatibility.</p></div><div class="step"><strong>02</strong><h3 data-en="Contact us" data-ar="تواصل معنا">Contact us</h3><p class="muted" data-en="Send the prepared order request on WhatsApp." data-ar="أرسل رسالة الطلب الجاهزة عبر واتساب.">Send the prepared order request on WhatsApp.</p></div><div class="step"><strong>03</strong><h3 data-en="Arrange activation" data-ar="إتمام التفعيل">Arrange activation</h3><p class="muted" data-en="Our team will confirm payment and activation instructions." data-ar="سيتم تأكيد طريقة الدفع وتعليمات التفعيل.">Our team will confirm payment and activation instructions.</p></div></div><div class="notice" style="margin-top:20px" data-en="Player activation licenses are separate from IPTV subscriptions. Lifetime means the applicable license term, not a guarantee of perpetual service availability. Check provider terms and refund conditions before ordering." data-ar="تراخيص تفعيل المشغلات منفصلة عن اشتراكات IPTV. مدى الحياة تعني مدة الترخيص حسب شروط المزود، ولا تضمن استمرار الخدمة إلى الأبد. راجع الشروط والاسترداد قبل الطلب.">Player activation licenses are separate from IPTV subscriptions. Lifetime means the applicable license term, not a guarantee of perpetual service availability. Check provider terms and refund conditions before ordering.</div></div></section>
<section class="section faq-section"><div class="container"><div class="section-head"><div><span class="eyebrow">FAQ</span><h2 data-en="Frequently asked questions" data-ar="الأسئلة الشائعة">Frequently asked questions</h2></div></div><div class="faq"><details><summary data-en="What will I receive after ordering?" data-ar="ماذا سأستلم بعد الطلب؟">What will I receive after ordering?</summary><p data-en={p.category==='activation'?'Activation instructions for the selected player license, subject to device compatibility. IPTV channels are not included.':'Our team will explain the subscription details and activation process before you pay.'} data-ar={p.category==='activation'?'تعليمات تفعيل الترخيص المحدد وفق توافق جهازك. لا يشمل قنوات IPTV.':'سيشرح لك فريقنا تفاصيل الاشتراك وطريقة التفعيل قبل الدفع.'}>{p.category==='activation'?'Activation instructions for the selected player license, subject to device compatibility. IPTV channels are not included.':'Our team will explain the subscription details and activation process before you pay.'}</p></details><details><summary data-en="How do I place an order?" data-ar="كيف أطلب المنتج؟">How do I place an order?</summary><p data-en="Tap Order via WhatsApp and send the prepared message. We will confirm the next steps." data-ar="اضغط اطلب عبر واتساب وأرسل الرسالة الجاهزة لتأكيد الخطوات التالية.">Tap Order via WhatsApp and send the prepared message. We will confirm the next steps.</p></details><details><summary data-en="Does this work on my device?" data-ar="هل يعمل على جهازي؟">Does this work on my device?</summary><p data-en="Compatibility depends on the application and device. Share your device model with support before purchasing." data-ar="التوافق يعتمد على التطبيق والجهاز. أرسل موديل جهازك للدعم قبل الشراء.">Compatibility depends on the application and device. Share your device model with support before purchasing.</p></details><details><summary data-en="Can I request support?" data-ar="هل يمكنني طلب المساعدة؟">Can I request support?</summary><p data-en="Yes. Contact us on WhatsApp for order and activation assistance." data-ar="نعم، تواصل عبر واتساب للمساعدة في الطلب والتفعيل.">Yes. Contact us on WhatsApp for order and activation assistance.</p></details></div></div></section>
{related.length>0&&<section class="section"><div class="container"><h2 data-en="You might also like" data-ar="قد يعجبك أيضاً">You might also like</h2><div class="grid">{related.map(item=><ProductCard product={item}/>)}</div></div></section>}</Base>
