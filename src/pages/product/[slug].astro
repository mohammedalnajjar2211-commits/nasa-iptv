---
import Base from '../../layouts/Base.astro';import ProductCard from '../../components/ProductCard.astro';import {products,money,whatsapp} from '../../data/products.js';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{product:p}}))}
const {product:p}=Astro.props;const related=products.filter(x=>x.category===p.category&&x.slug!==p.slug).slice(0,3);
const jsonLd={"@context":"https://schema.org","@type":"Product",name:p.name,description:p.description,offers:{"@type":"Offer",priceCurrency:'USD',price:p.price,availability:'https://schema.org/InStock',url:new URL(Astro.url.pathname,Astro.site).href}};
---
<Base title={`${p.name} | NASA IPTV`} description={p.description}><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/><section class="section"><div class="container"><p class="muted"><a href="/nasa-iptv/shop/" data-en="← Back to shop" data-ar="→ العودة للمتجر">← Back to shop</a></p><div class="product-detail"><div class="detail-visual">{p.image?<img src={p.image?.startsWith('/') ? '/nasa-iptv' + p.image : p.image} alt={p.name} width="840" height="840"/>:<div class="product-placeholder"><span>NASA IPTV</span><strong>{p.lifetime?'LIFETIME':p.months+' MONTHS'}</strong><small>PREMIUM DIGITAL</small></div>}</div><div class="detail-content"><span class="eyebrow" data-en={p.category==='activation'?'PLAYER ACTIVATION':'SUBSCRIPTION'} data-ar={p.category==='activation'?'تفعيل مشغل':'اشتراك'}>{p.category==='activation'?'PLAYER ACTIVATION':'SUBSCRIPTION'}</span><h1 data-en={p.name} data-ar={p.ar}>{p.name}</h1><p class="muted" data-en={p.description} data-ar={p.category==='activation'?'ترخيص تفعيل تطبيق المشغل فقط، دون اشتراك IPTV أو محتوى بث.':'اشتراك رقمي. يرجى تأكيد توافق جهازك وتفاصيل الخدمة قبل الشراء.'}>{p.description}</p><div class="detail-price">{money(p.price)}</div><ul class="detail-list"><li data-en="Digital product" data-ar="منتج رقمي">Digital product</li><li data-en="Order and activation assistance via WhatsApp" data-ar="الطلب والمساعدة في التفعيل عبر واتساب">Order and activation assistance via WhatsApp</li><li data-en={p.lifetime?'Lifetime license (provider terms apply)':p.months+'-month term'} data-ar={p.lifetime?'ترخيص مدى الحياة وفق شروط المزود':`مدة ${p.months} أشهر`}>{p.lifetime?'Lifetime license (provider terms apply)':p.months+'-month term'}</li><li data-en="Confirm device compatibility before ordering" data-ar="تأكد من توافق جهازك قبل الطلب">Confirm device compatibility before ordering</li></ul><a class="btn" href={whatsapp(p)} target="_blank" rel="noopener" data-en="Order via WhatsApp ↗" data-ar="اطلب عبر واتساب ↗">Order via WhatsApp ↗</a><p class="muted" style="font-size:12px" data-en="You will be redirected to WhatsApp. No online payment is collected here." data-ar="سيتم تحويلك إلى واتساب. لا يتم تحصيل أي دفع داخل الموقع.">You will be redirected to WhatsApp. No online payment is collected here.</p></div></div></div></section>
<section class="section features"><div class="container"><h2 data-en="How to order" data-ar="طريقة الطلب">How to order</h2><div class="grid"><div class="step"><strong>01</strong><h3 data-en="Choose your product" data-ar="اختر المنتج">Choose your product</h3><p class="muted" data-en="Check the plan, price and compatibility." data-ar="راجع المدة والسعر وتوافق جهازك.">Check the plan, price and compatibility.</p></div><div class="step"><strong>02</strong><h3 data-en="Contact us" data-ar="تواصل معنا">Contact us</h3><p class="muted" data-en="Send the prepared order request on WhatsApp." data-ar="أرسل رسالة الطلب الجاهزة عبر واتساب.">Send the prepared order request on WhatsApp.</p></div><div class="step"><strong>03</strong><h3 data-en="Arrange activation" data-ar="إتمام التفعيل">Arrange activation</h3><p class="muted" data-en="Our team will confirm payment and activation instructions." data-ar="سيتم تأكيد طريقة الدفع وتعليمات التفعيل.">Our team will confirm payment and activation instructions.</p></div></div><div class="notice" style="margin-top:20px" data-en="Player activation licenses are separate from IPTV subscriptions. Lifetime means the applicable license term, not a guarantee of perpetual service availability. Check provider terms and refund conditions before ordering." data-ar="تراخيص تفعيل المشغلات منفصلة عن اشتراكات IPTV. مدى الحياة تعني مدة الترخيص حسب شروط المزود، ولا تضمن استمرار الخدمة إلى الأبد. راجع الشروط والاسترداد قبل الطلب.">Player activation licenses are separate from IPTV subscriptions. Lifetime means the applicable license term, not a guarantee of perpetual service availability. Check provider terms and refund conditions before ordering.</div></div></section>
{related.length>0&&<section class="section"><div class="container"><h2 data-en="You might also like" data-ar="قد يعجبك أيضاً">You might also like</h2><div class="grid">{related.map(item=><ProductCard product={item}/>)}</div></div></section>}</Base>
