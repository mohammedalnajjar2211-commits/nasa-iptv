---
import Base from '../layouts/Base.astro';
---
<Base title="Subscription Renewal Reminder | NASA IPTV" description="Save your subscription expiry date, download a calendar reminder, and renew through WhatsApp.">
<section class="rr" id="renewal-reminder">
  <div class="rr-container">
    <div class="rr-hero">
      <span class="rr-kicker" data-en="NASA IPTV · SUBSCRIPTION TOOLS" data-ar="ناسا IPTV · أدوات الاشتراك">NASA IPTV · SUBSCRIPTION TOOLS</span>
      <h1 data-en="Never miss your renewal" data-ar="لا تنسَ موعد تجديد اشتراكك">Never miss your renewal</h1>
      <p data-en="Save your expiry date, see how many days remain, and add a reminder to your calendar." data-ar="احفظ تاريخ انتهاء اشتراكك، وشاهد الأيام المتبقية، وأضف تذكيراً إلى تقويم جهازك.">Save your expiry date, see how many days remain, and add a reminder to your calendar.</p>
    </div>
    <div class="rr-layout">
      <div class="rr-card">
        <h2 data-en="Your subscription" data-ar="بيانات اشتراكك">Your subscription</h2>
        <p class="rr-muted" data-en="The information stays in this browser only." data-ar="تبقى هذه المعلومات داخل متصفحك فقط.">The information stays in this browser only.</p>
        <form id="rr-form">
          <label for="rr-name" data-en="Subscription name (optional)" data-ar="اسم الاشتراك (اختياري)">Subscription name (optional)</label>
          <input id="rr-name" type="text" maxlength="80" placeholder="NASA IPTV" autocomplete="off"/>
          <label for="rr-date" data-en="Expiry date" data-ar="تاريخ انتهاء الاشتراك">Expiry date</label>
          <input id="rr-date" type="date" required/>
          <label for="rr-days" data-en="Remind me before expiry" data-ar="ذكّرني قبل انتهاء الاشتراك">Remind me before expiry</label>
          <select id="rr-days">
            <option value="1" data-en="1 day before" data-ar="قبل يوم واحد">1 day before</option>
            <option value="3" data-en="3 days before" data-ar="قبل 3 أيام">3 days before</option>
            <option value="7" selected data-en="7 days before" data-ar="قبل 7 أيام">7 days before</option>
            <option value="14" data-en="14 days before" data-ar="قبل 14 يوماً">14 days before</option>
          </select>
          <button class="rr-primary" type="submit" data-en="Save reminder" data-ar="حفظ التذكير">Save reminder</button>
        </form>
        <p class="rr-feedback" id="rr-feedback" role="status" aria-live="polite"></p>
      </div>
      <div class="rr-card rr-status">
        <div class="rr-status-head"><span data-en="SUBSCRIPTION STATUS" data-ar="حالة الاشتراك">SUBSCRIPTION STATUS</span><span id="rr-badge" class="rr-badge" data-en="Not set" data-ar="غير محدد">Not set</span></div>
        <div class="rr-count" id="rr-count">—</div>
        <div class="rr-count-label" id="rr-count-label" data-en="Enter an expiry date to get started" data-ar="أدخل تاريخ الانتهاء للبدء">Enter an expiry date to get started</div>
        <div class="rr-detail"><span data-en="Expiry date" data-ar="تاريخ الانتهاء">Expiry date</span><strong id="rr-expiry">—</strong></div>
        <div class="rr-detail"><span data-en="Reminder date" data-ar="تاريخ التذكير">Reminder date</span><strong id="rr-remind">—</strong></div>
        <div class="rr-buttons">
          <button type="button" id="rr-calendar" class="rr-primary" disabled data-en="Add to calendar (.ics)" data-ar="إضافة إلى التقويم (.ics)">Add to calendar (.ics)</button>
          <a id="rr-whatsapp" class="rr-whatsapp" href="https://wa.me/46700411342" target="_blank" rel="noopener noreferrer" data-en="Renew via WhatsApp" data-ar="جدّد عبر واتساب">Renew via WhatsApp</a>
        </div>
        <p class="rr-note" data-en="Calendar reminders are managed by your calendar app. Saving here does not send automatic SMS, email, or WhatsApp messages." data-ar="التنبيهات يديرها تطبيق التقويم لديك. الحفظ هنا لا يرسل رسائل SMS أو بريد إلكتروني أو واتساب تلقائياً.">Calendar reminders are managed by your calendar app. Saving here does not send automatic SMS, email, or WhatsApp messages.</p>
      </div>
    </div>
    <div class="rr-faq">
      <h2 data-en="How it works" data-ar="كيف يعمل التذكير؟">How it works</h2>
      <div class="rr-grid">
        <div><b>01</b><h3 data-en="Enter your date" data-ar="أدخل تاريخ الانتهاء">Enter your date</h3><p data-en="Choose the date your subscription expires." data-ar="حدد اليوم الذي ينتهي فيه اشتراكك.">Choose the date your subscription expires.</p></div>
        <div><b>02</b><h3 data-en="Save it" data-ar="احفظ البيانات">Save it</h3><p data-en="See your countdown whenever you return on the same browser." data-ar="شاهد العد التنازلي عند العودة من نفس المتصفح.">See your countdown whenever you return on the same browser.</p></div>
        <div><b>03</b><h3 data-en="Add calendar alert" data-ar="أضف تنبيه التقويم">Add calendar alert</h3><p data-en="Download an event and import it into your calendar for an actual alert." data-ar="نزّل ملف الموعد وأضفه إلى تقويمك للحصول على تنبيه فعلي.">Download an event and import it into your calendar for an actual alert.</p></div>
      </div>
    </div>
  </div>
</section>
<script>
  const root = document.getElementById('renewal-reminder');
  if (root) {
    const $ = (id) => document.getElementById(id);
    const form = $('rr-form'), dateInput = $('rr-date'), nameInput = $('rr-name'), daysInput = $('rr-days');
    const calendar = $('rr-calendar'), feedback = $('rr-feedback');
    const storageKey = 'nasa-renewal-reminder-v1';
    const ar = () => document.documentElement.dataset.lang === 'ar' || document.documentElement.lang === 'ar';
    const tr = (en, arabic) => ar() ? arabic : en;
    const parseDate = (value) => {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return null;
      const [y,m,d] = value.split('-').map(Number);
      const dt = new Date(y,m-1,d,12);
      return dt.getFullYear()===y && dt.getMonth()===m-1 && dt.getDate()===d ? dt : null;
    };
    const fmt = (d) => d ? new Intl.DateTimeFormat(ar()?'ar-IQ':'en-US',{year:'numeric',month:'short',day:'numeric'}).format(d) : '—';
    const dateKey = (d) => [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');
    const addDays = (date, days) => {const d=new Date(date);d.setDate(d.getDate()+days);return d;};
    const current = () => ({name:nameInput.value.trim(), date:dateInput.value, days:Number(daysInput.value)});
    const saved = (()=>{try{return JSON.parse(localStorage.getItem(storageKey)||'null')}catch{return null}})();
    if(saved && typeof saved==='object') {
      if(typeof saved.name==='string') nameInput.value=saved.name.slice(0,80);
      if(typeof saved.date==='string') dateInput.value=saved.date;
      if([1,3,7,14].includes(Number(saved.days))) daysInput.value=String(saved.days);
    }
    function render() {
      const data=current(), expiry=parseDate(data.date);
      if (!expiry) {
        $('rr-count').textContent='—';$('rr-count-label').textContent=tr('Enter an expiry date to get started','أدخل تاريخ الانتهاء للبدء');
        $('rr-expiry').textContent='—';$('rr-remind').textContent='—';$('rr-badge').textContent=tr('Not set','غير محدد');
        $('rr-badge').className='rr-badge';calendar.disabled=true;return;
      }
      const today=new Date();today.setHours(12,0,0,0);
      const remaining=Math.round((Date.UTC(expiry.getFullYear(),expiry.getMonth(),expiry.getDate())-Date.UTC(today.getFullYear(),today.getMonth(),today.getDate()))/86400000);
      const reminder=addDays(expiry,-data.days);
      $('rr-count').textContent=String(Math.abs(remaining));
      $('rr-count-label').textContent=remaining<0?tr('days since expiry','يوم منذ انتهاء الاشتراك'):remaining===0?tr('Expires today','ينتهي اليوم'):tr('days remaining','يوم متبقٍ');
      $('rr-expiry').textContent=fmt(expiry);$('rr-remind').textContent=fmt(reminder);
      $('rr-badge').textContent=remaining<0?tr('Expired','منتهي'):remaining<=data.days?tr('Renew soon','جدّد قريباً'):tr('Active date','موعد قادم');
      $('rr-badge').className='rr-badge '+(remaining<0?'rr-expired':remaining<=data.days?'rr-soon':'rr-active');
      calendar.disabled=false;
      const message=tr('Hello NASA IPTV, I would like to renew my subscription.','مرحباً NASA IPTV، أرغب بتجديد اشتراكي.');
      $('rr-whatsapp').href='https://wa.me/46700411342?text='+encodeURIComponent(message);
    }
    form.addEventListener('submit',(e)=>{
      e.preventDefault();
      if(!parseDate(dateInput.value)){feedback.textContent=tr('Please choose a valid expiry date.','يرجى اختيار تاريخ انتهاء صحيح.');return;}
      try{localStorage.setItem(storageKey,JSON.stringify(current()));feedback.textContent=tr('Saved in this browser. Add it to your calendar for an alert.','تم الحفظ في هذا المتصفح. أضف الموعد إلى التقويم للحصول على تنبيه.');}
      catch{feedback.textContent=tr('Browser storage is unavailable. You can still download the calendar event.','تعذر الحفظ في المتصفح، لكن يمكنك تنزيل موعد التقويم.');}
      render();
    });
    [dateInput,daysInput,nameInput].forEach(el=>el.addEventListener('input',()=>{feedback.textContent='';render();}));
    const icsEscape = (s) => String(s).replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;');
    calendar.addEventListener('click',()=>{
      const data=current(), expiry=parseDate(data.date);if(!expiry)return;
      const reminder=addDays(expiry,-data.days);
      const start=dateKey(reminder).replace(/-/g,'');
      const end=dateKey(addDays(reminder,1)).replace(/-/g,'');
      const title=icsEscape('NASA IPTV - Subscription renewal reminder'+(data.name?' ('+data.name+')':''));
      const now=new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d{3}/,'');
      const uid='nasa-renewal-'+start+'-'+Math.random().toString(36).slice(2)+'@nasa-iptv.net';
      const lines=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//NASA IPTV//Renewal Reminder//EN','CALSCALE:GREGORIAN','BEGIN:VEVENT','UID:'+uid,'DTSTAMP:'+now,'DTSTART;VALUE=DATE:'+start,'DTEND;VALUE=DATE:'+end,'SUMMARY:'+title,'DESCRIPTION:'+icsEscape('Renew your NASA IPTV subscription. Expiry: '+data.date+'. Support: https://wa.me/46700411342'),'BEGIN:VALARM','ACTION:DISPLAY','DESCRIPTION:N​​ASA IPTV subscription renewal reminder'.replace('\u200b',''),'TRIGGER:-PT9H','END:VALARM','END:VEVENT','END:VCALENDAR'];
      const blob=new Blob([lines.join('\r\n')+'\r\n'],{type:'text/calendar;charset=utf-8'});
      const url=URL.createObjectURL(blob), a=document.createElement('a');a.href=url;a.download='nasa-iptv-renewal.ics';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
      feedback.textContent=tr('Calendar file downloaded. Open it and confirm the event in your calendar.','تم تنزيل ملف التقويم. افتحه وأكّد إضافة الموعد في تطبيق التقويم.');
    });
    new MutationObserver(render).observe(document.documentElement,{attributes:true,attributeFilter:['lang','data-lang']});
    render();
  }
</script>
<style>
.rr{min-height:80vh;padding:55px 16px 100px;color:#eef5ff;background:radial-gradient(ellipse at 10% 0%,#16416a 0%,transparent 45%),linear-gradient(150deg,#06101f,#0b1b32 60%,#07111f)}
.rr *{box-sizing:border-box}.rr-container{max-width:1100px;margin:auto}.rr-hero{text-align:center;max-width:780px;margin:0 auto 34px}.rr-kicker{font-size:.77rem;letter-spacing:.12em;font-weight:800;color:#70c5ff}.rr-hero h1{color:#fff;font-size:clamp(2rem,4.7vw,3.5rem);line-height:1.16;margin:12px 0}.rr-hero p{color:#b9cce1;line-height:1.8;font-size:1.04rem}.rr-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px}.rr-card,.rr-faq{background:#0c1e33;border:1px solid #2a4967;border-radius:20px;padding:clamp(20px,3vw,32px);box-shadow:0 18px 50px #0002}.rr-card h2{margin:0 0 6px;color:#fff;font-size:1.4rem}.rr-muted{color:#adc1d8;font-size:.9rem;margin:0 0 22px}.rr form{display:grid;gap:10px}.rr label{color:#e4efff;font-weight:700;font-size:.92rem;margin-top:8px}.rr input,.rr select{display:block;width:100%;min-width:0;background:#122a43!important;color:#fff!important;border:1px solid #3b5b7a!important;border-radius:11px;padding:13px 14px;min-height:48px;font:inherit;color-scheme:dark}.rr input:focus,.rr select:focus{outline:2px solid #58b7ff;outline-offset:1px}.rr-primary,.rr-whatsapp{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border:0;border-radius:11px;font:inherit;font-weight:800;text-align:center;text-decoration:none;cursor:pointer}.rr-primary{background:#1679ed;color:#fff!important;margin-top:12px}.rr-primary:disabled{opacity:.45;cursor:not-allowed}.rr-whatsapp{background:#148060;color:#fff!important}.rr-feedback{color:#93d7ff;font-size:.86rem;line-height:1.6;min-height:1.5em;margin:12px 0 0}.rr-status-head{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:.77rem;font-weight:800;letter-spacing:.06em;color:#93badf}.rr-badge{border:1px solid #46627c;background:#1a334c;color:#d4e6fa;border-radius:30px;padding:5px 10px;letter-spacing:0}.rr-active{color:#9ae7c6;border-color:#2a795b;background:#113c33}.rr-soon{color:#ffe3a3;border-color:#9b7438;background:#463318}.rr-expired{color:#ffb6b6;border-color:#8a4242;background:#441f27}.rr-count{font-size:clamp(4.5rem,10vw,7rem);font-weight:900;line-height:1.1;color:#fff;margin-top:27px;font-variant-numeric:tabular-nums}.rr-count-label{font-size:1.08rem;color:#acd5f7;margin:0 0 30px}.rr-detail{display:flex;justify-content:space-between;gap:14px;padding:15px 0;border-top:1px solid #2a435e;color:#b4c7dc}.rr-detail strong{color:#fff;text-align:end}.rr-buttons{display:grid;gap:10px;margin-top:20px}.rr-note{color:#a9bfd6;font-size:.83rem;line-height:1.75;margin:18px 0 0}.rr-faq{margin-top:22px}.rr-faq h2{color:#fff;margin:0 0 20px;font-size:1.4rem}.rr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.rr-grid>div{background:#112940;border:1px solid #2a4865;border-radius:13px;padding:18px}.rr-grid b{color:#69bdff}.rr-grid h3{color:#fff;font-size:1rem;margin:9px 0}.rr-grid p{color:#b7c9dd;line-height:1.7;font-size:.9rem;margin:0}@media(max-width:760px){.rr{padding:32px 12px 100px}.rr-layout,.rr-grid{grid-template-columns:1fr}.rr-hero{margin-bottom:25px}.rr-card{padding:20px}.rr-count{font-size:5rem}} 
</style>
</Base>
