---
import Base from '../layouts/Base.astro';
---

<Base title="Renewal Reminder | NASA IPTV" description="Check your subscription expiry automatically and add a renewal reminder to your calendar.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">NASA IPTV</span>
      <h1 class="page-title" data-en="Subscription Renewal Reminder" data-ar="تذكير تجديد الاشتراك">Subscription Renewal Reminder</h1>
      <p data-en="Check your expiry date automatically and save a calendar reminder." data-ar="اعرف تاريخ انتهاء اشتراكك تلقائياً وأضف تذكيراً إلى التقويم.">Check your expiry date automatically and save a calendar reminder.</p>
    </div>
  </section>

  <section class="section check-section">
    <div class="container">
      <div class="check-card">
        <div class="check-card-head">
          <div class="check-icon" aria-hidden="true">✓</div>
          <h2 data-en="Renewal Reminder" data-ar="تذكير تجديد الاشتراك">Renewal Reminder</h2>
          <p data-en="Enter the username and password provided with your IPTV subscription." data-ar="أدخل اسم المستخدم وكلمة المرور الخاصة باشتراك IPTV.">Enter the username and password provided with your IPTV subscription.</p>
        </div>

        <form id="subscription-check-form" class="check-form" autocomplete="off">
          <label for="check-username" data-en="Username" data-ar="اسم المستخدم">Username</label>
          <input id="check-username" name="username" type="text" required maxlength="150" autocomplete="off" spellcheck="false" placeholder="Username" data-placeholder-en="Username" data-placeholder-ar="اسم المستخدم" />

          <label for="check-password" data-en="Password" data-ar="كلمة المرور">Password</label>
          <div class="password-wrap">
            <input id="check-password" name="password" type="password" required maxlength="150" autocomplete="off" placeholder="Password" data-placeholder-en="Password" data-placeholder-ar="كلمة المرور" />
            <button type="button" id="toggle-check-password" class="show-password" aria-label="Show password" data-aria-en="Show or hide password" data-aria-ar="إظهار أو إخفاء كلمة المرور">◉</button>
          </div>

          <button class="btn check-submit" id="check-submit" type="submit">
            <span data-en="Check & Get Reminder" data-ar="فحص وإعداد التذكير">Check & Get Reminder</span>
            <span aria-hidden="true">↗</span>
          </button>
        </form>

        <div id="check-message" class="check-message" role="status" aria-live="polite" hidden></div>

        <div id="check-result" class="check-result" aria-live="polite" hidden>
          <div class="result-heading">
            <span id="result-symbol" aria-hidden="true"></span>
            <strong id="result-status"></strong>
          </div>
          <div id="result-details" class="result-details"></div>
        </div>

        <div id="reminder-panel" class="reminder-panel" hidden>
          <h3 data-en="Set your renewal reminder" data-ar="إعداد تذكير التجديد">Set your renewal reminder</h3>
          <p data-en="Your expiry date was retrieved automatically. Download a calendar event for a reminder." data-ar="تم جلب تاريخ الانتهاء تلقائياً. نزّل موعد التقويم للحصول على تنبيه.">Your expiry date was retrieved automatically. Download a calendar event for a reminder.</p>
          <label for="reminder-days" data-en="Remind me before expiry" data-ar="ذكّرني قبل انتهاء الاشتراك">Remind me before expiry</label>
          <select id="reminder-days">
            <option value="1" data-en="1 day before" data-ar="قبل يوم واحد">1 day before</option>
            <option value="3" data-en="3 days before" data-ar="قبل 3 أيام">3 days before</option>
            <option value="7" selected data-en="7 days before" data-ar="قبل 7 أيام">7 days before</option>
            <option value="14" data-en="14 days before" data-ar="قبل 14 يوماً">14 days before</option>
          </select>
          <button type="button" class="btn check-submit" id="download-reminder" data-en="Download calendar reminder (.ics)" data-ar="تنزيل تذكير التقويم (.ics)">Download calendar reminder (.ics)</button>
          <p class="check-note" data-en="Open the downloaded file and confirm the event in your calendar. No automatic WhatsApp or email is sent." data-ar="افتح الملف وأكّد إضافة الموعد في التقويم. لا تُرسل رسائل واتساب أو بريد تلقائياً.">Open the downloaded file and confirm the event in your calendar. No automatic WhatsApp or email is sent.</p>
          <a class="renew-link" href="https://wa.me/46700411342" target="_blank" rel="noopener noreferrer" data-en="Renew via WhatsApp" data-ar="جدّد عبر واتساب">Renew via WhatsApp</a>
        </div>
        <p class="check-note" data-en="Your credentials are sent to the subscription-checking service to verify your account. Avoid checking accounts on shared devices." data-ar="تُرسل بيانات الدخول إلى خدمة فحص الاشتراك للتحقق من حسابك. تجنب الفحص على الأجهزة المشتركة.">Your credentials are sent to the subscription-checking service to verify your account. Avoid checking accounts on shared devices.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .check-section { padding-top: 42px; padding-bottom: 70px; }
  .check-card { width: min(100%, 530px); margin-inline: auto; padding: clamp(20px, 4vw, 36px); border: 1px solid rgba(98, 165, 241, .26); border-radius: 22px; background: linear-gradient(155deg, #112b4c 0%, #091a31 100%); box-shadow: 0 24px 65px rgba(0,0,0,.24), 0 0 30px rgba(0,121,255,.08); color: #fff; }
  .check-card-head { text-align: center; margin-bottom: 27px; }
  .check-icon { width: 60px; height: 60px; margin: 0 auto 15px; display: grid; place-items: center; border-radius: 17px; color: #fff; font-size: 30px; font-weight: 800; background: linear-gradient(135deg, #0f94fa, #0750a7); box-shadow: 0 9px 26px rgba(0,125,255,.28); }
  .check-card h2 { color: #fff; margin: 0 0 10px; font-size: clamp(20px, 4.2vw, 27px); }
  .check-card-head p { color: #bdcee4; font-size: 14px; line-height: 1.8; margin: 0; }
  .check-form { display: flex; flex-direction: column; gap: 10px; }
  .check-form label { font-size: 14px; font-weight: 700; color: #e5efff; text-align: start; }
  .check-form input { box-sizing: border-box; display: block; width: 100%; min-width: 0; height: 51px; padding: 12px 15px; border: 1px solid #385779; border-radius: 11px; outline: none; background: #091b30; color: #fff; font: inherit; font-size: 16px; direction: ltr; text-align: left; }
  .check-form input:focus { border-color: #27a0ff; box-shadow: 0 0 0 3px rgba(39,160,255,.16); }
  .check-form input::placeholder { color: #8da6c4; }
  .password-wrap { position: relative; }
  .password-wrap input { padding-right: 52px; }
  .show-password { position: absolute; right: 5px; top: 5px; width: 41px; height: 41px; border: 0; border-radius: 9px; background: transparent; color: #bcd4ef; cursor: pointer; font-size: 19px; }
  .show-password:hover { background: #1a3b5d; }
  .check-submit { width: 100%; min-height: 52px; margin-top: 12px; display: flex; justify-content: center; align-items: center; gap: 10px; border: 1px solid #269bff; border-radius: 11px; background: linear-gradient(115deg, #087fdf, #0755b7); color: #fff; font-weight: 800; font-size: 16px; cursor: pointer; }
  .check-submit:disabled { opacity: .65; cursor: wait; }
  .check-message { margin-top: 17px; border: 1px solid #b56c3b; background: rgba(130,67,25,.16); color: #ffe1c5; padding: 13px 15px; border-radius: 11px; font-size: 14px; line-height: 1.7; text-align: center; }
  .check-result { margin-top: 19px; padding: 20px; border: 1px solid #2c5d84; border-radius: 14px; background: rgba(5,18,34,.65); }
  .check-result.is-active { border-color: rgba(53,213,135,.5); }
  .check-result.is-inactive { border-color: rgba(255,116,116,.5); }
  .result-heading { display: flex; justify-content: center; align-items: center; gap: 9px; font-size: 19px; text-align: center; }
  .is-active .result-heading { color: #52e8a3; }
  .is-inactive .result-heading { color: #ff8a8a; }
  .result-details { margin-top: 16px; display: grid; gap: 11px; }
  .result-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border-bottom: 1px solid rgba(175,211,249,.12); padding-bottom: 10px; font-size: 14px; }
  .result-row span { color: #bbcee7; }
  .result-row strong { text-align: end; overflow-wrap: anywhere; }
  .check-note { margin: 19px 0 0; text-align: center; font-size: 12px; line-height: 1.8; color: #aabdd5; }
  [hidden] { display: none !important; }
  .reminder-panel { margin-top: 22px; border: 1px solid #2d709c; border-radius: 15px; background: #0b223a; padding: 20px; }
  .reminder-panel h3 { color: #fff; margin: 0 0 9px; font-size: 20px; }
  .reminder-panel p { color: #bed3e9; line-height: 1.7; }
  .reminder-panel label { display:block; margin: 14px 0 8px; color: #e5efff; font-weight: 700; }
  .reminder-panel select { width:100%; padding: 13px; border-radius: 10px; border: 1px solid #385779; background: #091b30; color: #fff; font: inherit; color-scheme:dark; }
  .renew-link { display: block; margin-top: 14px; text-align:center; border-radius: 10px; padding: 13px; background: #12795c; color: #fff !important; text-decoration:none; font-weight:800; }

  @media (max-width: 600px) { .check-section { padding-top: 24px; } .check-card { border-radius: 16px; } .result-row { flex-wrap: wrap; } }
</style>

<script is:inline>
(() => {
  // Same subscription-checking endpoint as /check-iptv/.
  const API = 'https://check.mohammedalnajjar2211.workers.dev/';
  const $ = (id) => document.getElementById(id);
  const form = $('subscription-check-form');
  if (!form) return;
  const user = $('check-username'), pass = $('check-password'), submit = $('check-submit');
  const message = $('check-message'), result = $('check-result');
  const details = $('result-details'), panel = $('reminder-panel');
  const lang = () => document.documentElement.dataset.lang === 'ar' ? 'ar' : 'en';
  const tr = (en, ar) => lang() === 'ar' ? ar : en;
  let last = null, expiry = null;
  const setMessage = (value) => { message.textContent = value; message.hidden = !value; };
  const makeRow = (label, value) => {
    const row = document.createElement('div'); row.className = 'result-row';
    const key = document.createElement('span'), val = document.createElement('strong');
    key.textContent = label; val.textContent = value;
    row.append(key, val); return row;
  };
  function render(data) {
    details.replaceChildren(); panel.hidden = true; expiry = null;
    const info = data && data.user_info;
    result.hidden = false;
    const active = info && String(info.status || '').toLowerCase() === 'active';
    result.className = 'check-result ' + (active ? 'is-active' : 'is-inactive');
    $('result-symbol').textContent = active ? '✓' : '✕';
    $('result-status').textContent = !info
      ? tr('Account not found or invalid credentials','الحساب غير موجود أو بيانات الدخول غير صحيحة')
      : active ? tr('Account Active','الحساب نشط') : tr('Account Not Active','الحساب غير نشط');
    if (!info) return;
    if (data.package_name) details.append(makeRow(tr('Package','الباقة'),String(data.package_name)));
    const raw = info.exp_date;
    if (String(raw).toLowerCase() === 'unlimited') {
      details.append(makeRow(tr('Expiration date','تاريخ الانتهاء'),tr('Unlimited','غير محدود')));
      return;
    }
    const seconds = Number(raw);
    if (raw == null || raw === '' || !Number.isFinite(seconds) || seconds <= 0) {
      details.append(makeRow(tr('Expiration date unavailable','تاريخ الانتهاء غير متوفر'),'—'));
      return;
    }
    const date = new Date(seconds * 1000);
    if (Number.isNaN(date.getTime())) return;
    expiry = date;
    const remaining = Math.max(0,Math.ceil((date.getTime() - Date.now()) / 86400000));
    details.append(makeRow(tr('Expiration date','تاريخ الانتهاء'),date.toLocaleString(lang() === 'ar' ? 'ar-IQ':'en-GB',{dateStyle:'medium',timeStyle:'short'})));
    details.append(makeRow(tr('Days remaining','الأيام المتبقية'),String(remaining)));
    if (date.getTime() > Date.now()) panel.hidden = false;
    else details.append(makeRow(tr('Renewal','التجديد'),tr('Expired','منتهي')));
  }
  function updateLanguage() {
    document.querySelectorAll('[data-placeholder-en]').forEach(el => {
      el.placeholder = el.dataset[lang() === 'ar' ? 'placeholderAr' : 'placeholderEn'];
    });
    document.querySelectorAll('[data-aria-en]').forEach(el => {
      el.setAttribute('aria-label',el.dataset[lang() === 'ar' ? 'ariaAr' : 'ariaEn']);
    });
    if (last) render(last);
  }
  updateLanguage();
  new MutationObserver(updateLanguage).observe(document.documentElement,{attributes:true,attributeFilter:['data-lang']});
  $('toggle-check-password').addEventListener('click',()=>{
    pass.type = pass.type === 'password' ? 'text' : 'password';
  });
  const escapeIcs = (value) => String(value).replace(/\\/g,'\\\\').replace(/\r?\n/g,'\\n').replace(/,/g,'\\,').replace(/;/g,'\\;');
  const ymd = (d) => [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('');
  $('download-reminder').addEventListener('click',()=>{
    if (!expiry || expiry.getTime() <= Date.now()) return;
    const days = Number($('reminder-days').value);
    const reminder = new Date(expiry.getFullYear(),expiry.getMonth(),expiry.getDate(),12);
    reminder.setDate(reminder.getDate()-days);
    const end = new Date(reminder); end.setDate(end.getDate()+1);
    const stamp = new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d{3}/,'');
    const lines = [
      'BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//NASA IPTV//Renewal Reminder//EN',
      'CALSCALE:GREGORIAN','BEGIN:VEVENT',
      'UID:nasa-renewal-'+Date.now()+'@nasa-iptv.net','DTSTAMP:'+stamp,
      'DTSTART;VALUE=DATE:'+ymd(reminder),'DTEND;VALUE=DATE:'+ymd(end),
      'SUMMARY:'+escapeIcs('NASA IPTV - Subscription Renewal Reminder'),
      'DESCRIPTION:'+escapeIcs('Subscription expires: '+expiry.toISOString()+'. Renew: https://wa.me/46700411342'),
      'BEGIN:VALARM','ACTION:DISPLAY','DESCRIPTION:NASA IPTV renewal reminder',
      'TRIGGER:-PT9H','END:VALARM','END:VEVENT','END:VCALENDAR'
    ];
    const blob = new Blob([lines.join('\r\n')+'\r\n'],{type:'text/calendar;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'nasa-iptv-renewal.ics';
    document.body.append(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1000);
    setMessage(tr('Calendar file downloaded. Open it to add the reminder.','تم تنزيل ملف التقويم. افتحه لإضافة التذكير.'));
  });
  form.addEventListener('submit',async(event)=>{
    event.preventDefault();
    const username=user.value.trim(), password=pass.value.trim();
    result.hidden=true; panel.hidden=true; last=null; expiry=null; setMessage('');
    if (!username || !password) {setMessage(tr('Enter username and password.','أدخل اسم المستخدم وكلمة المرور.'));return;}
    submit.disabled=true;
    submit.querySelector('span').textContent=tr('Checking…','جارٍ الفحص…');
    try {
      const url=new URL(API); url.searchParams.set('user',username); url.searchParams.set('pass',password);
      const controller=new AbortController();
      const timeout=setTimeout(()=>controller.abort(),16000);
      let response;
      try {response=await fetch(url.toString(),{signal:controller.signal,cache:'no-store'});}
      finally {clearTimeout(timeout);}
      if(!response.ok) throw new Error('HTTP '+response.status);
      const data=await response.json();
      if(data && data.error) throw new Error('API error');
      last=data; render(data);
    } catch(error) {
      setMessage(tr('Unable to check your subscription right now. Please try again later.','تعذر فحص الاشتراك حالياً. يرجى المحاولة لاحقاً.'));
    } finally {
      submit.disabled=false;
      submit.querySelector('span').textContent=tr('Check & Get Reminder','فحص وإعداد التذكير');
      pass.value='';
    }
  });
})();
</script>
