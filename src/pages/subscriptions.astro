---
import Base from '../layouts/Base.astro';import ProductCard from '../components/ProductCard.astro';import {products} from '../data/products.js';
---
<Base title="NASA IPTV Subscription Plans | 3, 6, 12 & 24 Months" description="Explore NASA IPTV subscription plans for 3, 6, 12 and 24 months. Compare available packages, choose your preferred plan and order directly via WhatsApp."><section class="page-hero"><div class="container"><h1 class="page-title" data-en="Subscription plans" data-ar="باقات الاشتراك">Subscription plans</h1><p data-en="Choose your preferred plan and order directly on WhatsApp." data-ar="اختر الباقة المناسبة وأرسل طلبك مباشرة عبر واتساب.">Choose your preferred plan and order directly on WhatsApp.</p></div></section><section class="section"><div class="container"><div class="grid">{products.filter(p=>p.category==='subscription').map(p=><ProductCard product={p}/>)}</div></div></section></Base>
